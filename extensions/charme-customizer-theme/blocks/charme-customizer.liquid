{%- assign studio_url = 'https://charme-customizer.pages.dev/studio/?shop=' | append: shop.permanent_domain -%}
{%- if block.settings.template_id != blank -%}
  {%- assign template_id = block.settings.template_id | strip | url_encode -%}
  {%- assign studio_url = studio_url | append: '&template=' | append: template_id -%}
{%- endif -%}
<div class="charme-studio-block" {{ block.shopify_attributes }}>
  <a class="charme-studio-button" href="{{ studio_url | escape }}" target="_blank" rel="noopener noreferrer">
    {{ block.settings.button_label | escape }} <span aria-hidden="true">↗</span>
  </a>
  {%- if block.settings.description != blank -%}<p>{{ block.settings.description | escape }}</p>{%- endif -%}
</div>
<style>
  .charme-studio-block{text-align:{{ block.settings.button_align }};margin:1rem 0}
  .charme-studio-button{display:inline-flex;align-items:center;justify-content:center;gap:.75rem;min-height:48px;padding:.8rem 1.5rem;background:#aec6d5;color:#1a1614;text-decoration:none;font:600 1rem/1.2 system-ui,sans-serif}
  .charme-studio-button:hover{opacity:.88}
  .charme-studio-block p{margin:.65rem 0 0;font-size:.9rem}
</style>
{% schema %}
{
  "name": "Product Studio",
  "target": "section",
  "settings": [
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Customize this product" },
    { "type": "text", "id": "description", "label": "Short description", "default": "Design your product in the studio. A maker will review your request before checkout." },
    { "type": "text", "id": "template_id", "label": "Studio template ID (optional)", "info": "Leave blank to show the five customization workflows." },
    { "type": "select", "id": "button_align", "label": "Button alignment", "default": "center", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
    ] }
  ]
}
{% endschema %}
