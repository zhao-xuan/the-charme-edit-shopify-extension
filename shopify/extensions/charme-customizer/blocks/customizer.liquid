{% comment %}
  Charmé Customizer — theme app extension block.

  Add it to a product page from the theme editor (Add block → Apps → Charmé
  Customizer). It renders an inline config object, loads the bundled widget, and
  the widget adds the finished design to the cart via /cart/add.js.

  Settings (schema below):
    • Variant map JSON  – maps customizer ids → Shopify variant ids
    • Proof upload endpoint (optional) – stores the preview PNG, returns a URL
    • After add to cart  – go to /cart, open the drawer, or stay
    • Widget height
{% endcomment %}

<div
  id="charme-customizer-root"
  class="charme-customizer"
  style="min-height: {{ block.settings.height }};"
  data-block-id="{{ block.id }}"
></div>

<script>
  (function () {
    // Derive the extension asset base from any asset_url (all assets share it).
    var sampleAsset = {{ 'charm-catalog.json' | asset_url | json }};
    var assetBase = sampleAsset.split('charm-catalog.json')[0];

    var variantMap = {};
    try {
      variantMap = JSON.parse({{ block.settings.variant_map | json }} || '{}');
    } catch (e) {
      console.error('[Charmé] Variant map is not valid JSON', e);
    }

    window.CharmeConfig = {
      assetBase: assetBase,
      variantMap: variantMap,
      uploadEndpoint: {{ block.settings.upload_endpoint | json }},
      cartRedirect: {{ block.settings.cart_redirect | json }},
      height: {{ block.settings.height | json }},
      mountId: 'charme-customizer-root',
      shop: {{ shop.permanent_domain | json }}
    };
  })();
</script>

<script src="{{ 'charme-customizer.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'charme-customizer.css' | asset_url }}">

{% schema %}
{
  "name": "Charmé Customizer",
  "target": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "variant_map",
      "label": "Variant map (JSON)",
      "info": "Maps customizer product/charm ids to Shopify variant ids. See widget/variant-map.example.json.",
      "default": "{\n  \"products\": {},\n  \"charms\": {}\n}"
    },
    {
      "type": "url",
      "id": "upload_endpoint",
      "label": "Proof upload endpoint (optional)",
      "info": "POST {designToken, image} → { url }. Stores the preview PNG on Shopify Files. Leave blank to send the layout JSON only."
    },
    {
      "type": "select",
      "id": "cart_redirect",
      "label": "After add to cart",
      "options": [
        { "value": "cart", "label": "Go to cart page" },
        { "value": "drawer", "label": "Open cart drawer" },
        { "value": "none", "label": "Stay on page" }
      ],
      "default": "cart"
    },
    {
      "type": "text",
      "id": "height",
      "label": "Widget height",
      "default": "86vh"
    }
  ],
  "presets": [{ "name": "Charmé Customizer" }]
}
{% endschema %}
