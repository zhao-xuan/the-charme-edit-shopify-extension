{% comment %}
  Charmé Customizer — one-click drop-in section.
  ---------------------------------------------------------------------------
  Renders the charm customizer on any Online Store 2.0 theme. Everything (the
  widget code, the 379 charms and every case / gel render, and the live
  catalogue) is served from your Cloudflare Pages CDN, so this file is the ONLY
  thing you add to the theme.

  Checkout stays 100% native Shopify: the widget runs on this storefront page
  (not an iframe) and "Add to bag" posts to /cart/add.js, so the cart, checkout,
  payment and the order in Shopify Admin are all handled by Shopify.

  HOW TO INSTALL
  1. Online Store → Themes → ⋯ → Edit code.
  2. Under "Sections", Add a new section → name it `charme-customizer` →
     paste this whole file → Save.
  3. Open the page/template where you want it (e.g. a "Build your own case"
     page) in the theme editor → Add section → "Charmé Customizer".
  4. In the section settings, paste your Variant map JSON (see the generated
     shopify/widget/variant-map.template.json — fill in your Shopify variant
     ids). Everything else has sensible defaults.
{% endcomment %}

{%- assign api_base = section.settings.api_base | default: 'https://charme-customizer.pages.dev' | strip -%}
{%- assign mount_id = section.settings.mount_id -%}
{%- if mount_id == blank -%}{%- assign mount_id = 'charme-customizer-' | append: section.id -%}{%- endif -%}

<div id="charme-root-{{ section.id }}" class="charme-trigger-wrap--{{ section.settings.button_align | default: 'center' }}">
  <button type="button" class="charme-trigger" data-charme-open aria-haspopup="dialog">
    {{ section.settings.button_label | default: 'Design your own' | escape }}
  </button>
  <div class="charme-modal" data-charme-modal hidden role="dialog" aria-modal="true" aria-label="Charmé Customizer">
    <div class="charme-modal__panel">
      <div class="charme-modal__topbar">
        <button type="button" class="charme-back" data-charme-close aria-label="Back to product">
          <span class="charme-back__arrow" aria-hidden="true">&#8592;</span>
          <span>{{ section.settings.back_label | default: 'Back' | escape }}</span>
        </button>
      </div>
      <div id="{{ mount_id }}" class="charme-customizer"></div>
    </div>
  </div>
</div>
<style>
  .charme-trigger-wrap--left{display:flex;justify-content:flex-start}
  .charme-trigger-wrap--center{display:flex;justify-content:center}
  .charme-trigger-wrap--right{display:flex;justify-content:flex-end}
  .charme-trigger{font:inherit;cursor:pointer;border:0;border-radius:0;padding:14px 30px;background:#AEC6D5;color:#1a1614;font-size:16px;letter-spacing:.02em}
  .charme-trigger:hover{opacity:.9}
  .charme-modal{position:fixed;inset:0;z-index:2147483000}
  .charme-modal[hidden]{display:none}
  .charme-modal__panel{position:absolute;inset:0;background:#fff;display:flex;flex-direction:column}
  .charme-modal__topbar{flex:0 0 auto;display:flex;align-items:center;gap:10px;padding:10px 16px;border-bottom:1px solid #eceae7;background:#fff}
  .charme-back{display:inline-flex;align-items:center;gap:8px;font:inherit;cursor:pointer;border:0;border-radius:0;background:transparent;color:#1a1614;font-size:15px;padding:8px 10px}
  .charme-back:hover{opacity:.65}
  .charme-back__arrow{font-size:18px;line-height:1}
  .charme-modal__panel .charme-customizer{flex:1 1 auto;min-height:0}
  body.charme-modal-open{overflow:hidden}
</style>

<script>
  (function () {
    var variantMap = { products: {}, charms: {} };
    try {
      variantMap = JSON.parse({{ section.settings.variant_map | json }} || '{}');
    } catch (e) {
      console.error('[Charmé] Variant map is not valid JSON —', e);
    }
    window.CharmeConfig = {
      apiBase: {{ api_base | json }},
      orderMode: {{ section.settings.order_mode | json }},
      variantMap: variantMap,
      uploadEndpoint: {{ section.settings.upload_endpoint | json }},
      cartRedirect: {{ section.settings.cart_redirect | json }},
      defaultGroup: {{ section.settings.default_group | json }},
      defaultProductId: {{ section.settings.default_product | strip | json }},
      presetHandle: {{ product.handle | default: '' | strip | json }},
      height: "100%",
      mountId: {{ mount_id | json }},
      lazy: true,
      shop: {{ shop.permanent_domain | json }}
    };
  })();
</script>

<link rel="stylesheet" href="{{ api_base }}/widget/charme-customizer.css">
<script src="{{ api_base }}/widget/charme-customizer.js" defer></script>

<script>
  (function () {
    var root = document.getElementById('charme-root-{{ section.id }}');
    if (!root) return;
    var modal = root.querySelector('[data-charme-modal]');
    function ensureMounted(tries) {
      if (window.CharmeCustomizer && window.CharmeCustomizer.mount) {
        window.CharmeCustomizer.mount();
        window.dispatchEvent(new Event('resize'));
        return;
      }
      if (tries > 0) setTimeout(function () { ensureMounted(tries - 1); }, 80);
    }
    function nudgeResize() {
      // The stage measures its container on resize; fire a few times across
      // frames so it picks up the full-page dimensions once layout settles.
      [0, 60, 200, 500].forEach(function (t) {
        setTimeout(function () { window.dispatchEvent(new Event('resize')); }, t);
      });
    }
    function open() {
      modal.hidden = false;
      document.body.classList.add('charme-modal-open');
      ensureMounted(80);
      nudgeResize();
    }
    function close() {
      modal.hidden = true;
      document.body.classList.remove('charme-modal-open');
    }
    root.querySelectorAll('[data-charme-open]').forEach(function (b) { b.addEventListener('click', open); });
    root.querySelectorAll('[data-charme-close]').forEach(function (b) { b.addEventListener('click', close); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) close(); });
  })();
</script>

{% schema %}
{
  "name": "Charmé Customizer",
  "settings": [
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Design your own"
    },
    {
      "type": "select",
      "id": "button_align",
      "label": "Button alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back button label",
      "info": "Shown at the top of the full-page customizer to return to the product page.",
      "default": "Back"
    },
    {
      "type": "header",
      "content": "Orders & payment"
    },
    {
      "type": "select",
      "id": "order_mode",
      "label": "Order method",
      "options": [
        { "value": "cart", "label": "Add to cart / drawer (needs variants)" },
        { "value": "draft", "label": "Draft order → hosted checkout (no variants)" }
      ],
      "info": "Cart mode drops the design into the native cart/drawer (set a variant map below). Draft order builds the order server-side at validated prices with no per-charm variants (needs Pages secrets SHOPIFY_STORE + SHOPIFY_ADMIN_TOKEN — see shopify/README.md).",
      "default": "cart"
    },
    {
      "type": "header",
      "content": "Cart mapping (only for Add to cart / drawer mode)"
    },
    {
      "type": "textarea",
      "id": "variant_map",
      "label": "Variant map (JSON)",
      "info": "Maps the case model + charms to Shopify variant ids. Tip: use \"charmByPrice\" so a couple of generic Charm variants cover every charm. See shopify/widget/variant-map.template.json.",
      "default": "{\n  \"products\": {},\n  \"charms\": {},\n  \"charmByPrice\": {}\n}"
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "select",
      "id": "cart_redirect",
      "label": "After add to bag",
      "options": [
        { "value": "drawer", "label": "Open cart drawer" },
        { "value": "cart", "label": "Go to cart page" },
        { "value": "none", "label": "Stay on page" }
      ],
      "default": "drawer"
    },
    {
      "type": "select",
      "id": "default_group",
      "label": "Start on category",
      "info": "Which tab the customizer opens on. Ignored if you set a Start on model below.",
      "options": [
        { "value": "apple", "label": "Apple" },
        { "value": "android", "label": "Android" },
        { "value": "tote", "label": "Totes" },
        { "value": "frame", "label": "Frames" }
      ],
      "default": "apple"
    },
    {
      "type": "text",
      "id": "default_product",
      "label": "Start on model (optional)",
      "info": "Customizer model id to open on, e.g. iphone-16-pro, galaxy-s24-ultra, tote-tj, frame-5x7. Lets the same widget default to a different product on each product page."
    },
    {
      "type": "url",
      "id": "upload_endpoint",
      "label": "Proof upload endpoint (optional)",
      "info": "POST {designToken, image} → { url }. Stores the preview PNG so it rides on the order. Leave blank to send the layout JSON only."
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "api_base",
      "label": "Widget CDN / API base",
      "info": "Your Cloudflare Pages URL that hosts the widget, charm art and catalogue. No trailing slash.",
      "default": "https://charme-customizer.pages.dev"
    },
    {
      "type": "text",
      "id": "mount_id",
      "label": "Mount element id",
      "default": "charme-customizer-root"
    }
  ],
  "presets": [{ "name": "Charmé Customizer" }]
}
{% endschema %}
