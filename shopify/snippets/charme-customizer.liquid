{% comment %}
  Charmé Customizer — SNIPPET version (place the button ANYWHERE inside a section).

  The section file (sections/charme-customizer.liquid) can only be added as its
  own full-width block. This snippet renders the same button + popup but can sit
  INSIDE existing sections — next to the Add to cart button, inside the product
  info column, in the cart, etc.

  TWO WAYS TO PLACE IT
  A) No code — "Custom Liquid" block:
     1. Save this file as snippets/charme-customizer.liquid (Edit code → Snippets
        → Add a new snippet → name it `charme-customizer`).
     2. In the theme editor, add a **Custom Liquid** block where you want it
        (e.g. the product page's product-information section, or the cart), and
        put just:  {% render 'charme-customizer' %}
  B) In theme code — render it at an exact spot, e.g. right after the buy button
     in sections/main-product.liquid or the cart template:
        {% render 'charme-customizer' %}

  OPTIONAL OVERRIDES (per placement):
     {% render 'charme-customizer',
         button_label: 'Design your own',
         default_product: 'iphone-16-pro',
         id: 'pdp' %}

  EDIT THE CONFIG DEFAULTS BELOW (especially the variant map) to match your store.
{% endcomment %}

{%- assign cfg_api_base    = api_base       | default: 'https://charme-customizer.pages.dev' -%}
{%- assign cfg_btn_label   = button_label   | default: 'Design your own' -%}
{%- assign cfg_btn_align   = button_align   | default: 'center' -%}
{%- assign cfg_order_mode  = order_mode     | default: 'cart' -%}
{%- assign cfg_cart_redir  = cart_redirect  | default: 'drawer' -%}
{%- assign cfg_def_group   = default_group  | default: 'apple' -%}
{%- assign cfg_def_product = default_product | default: '' -%}
{%- assign cfg_preset      = preset_handle  | default: product.handle -%}
{%- assign cfg_logo        = logo_url -%}
{%- assign uid             = id             | default: 'charme' -%}

{%- comment %} Variant map: pass a `variant_map` string, or edit this default. {%- endcomment -%}
{%- capture cfg_variant_map -%}
{%- if variant_map -%}{{ variant_map }}{%- else -%}
{
  "products": {},
  "charms": {},
  "charmByPrice": {}
}
{%- endif -%}
{%- endcapture -%}

<div id="charme-root-{{ uid }}" class="charme-trigger-wrap--{{ cfg_btn_align }}">
  <button type="button" class="charme-trigger" data-charme-open aria-haspopup="dialog">{{ cfg_btn_label | escape }}</button>
  <div class="charme-modal" data-charme-modal hidden role="dialog" aria-modal="true" aria-label="Charmé Customizer">
    <div class="charme-modal__panel">
      <div class="charme-modal__topbar">
        <button type="button" class="charme-back" data-charme-close aria-label="Back to product">
          <span class="charme-back__arrow" aria-hidden="true">&#8592;</span>
          <span class="charme-back__label">{{ back_label | default: 'Back' | escape }}</span>
        </button>
        {%- if cfg_logo -%}
          <img class="charme-logo-img" src="{{ cfg_logo }}" alt="{{ shop.name | escape }}">
        {%- else -%}
          <span class="charme-logo">{{ shop.name | escape }}</span>
        {%- endif -%}
      </div>
      <div id="charme-customizer-{{ uid }}" class="charme-customizer"></div>
    </div>
  </div>
</div>
<style>
  .charme-trigger-wrap--left{display:flex;justify-content:flex-start}
  .charme-trigger-wrap--center{display:flex;justify-content:center}
  .charme-trigger-wrap--right{display:flex;justify-content:flex-end}
  .charme-trigger{font-family:'Azeret Mono',ui-monospace,monospace;font-size:16px;font-weight:500;line-height:normal;cursor:pointer;border:0;border-radius:0;padding:14px 30px;background:#AEC6D5;color:#1a1614;letter-spacing:0;width:100%}
  .charme-trigger:hover{opacity:.9}
  .charme-modal{position:fixed;inset:0;z-index:2147483000}
  .charme-modal[hidden]{display:none}
  .charme-modal__panel{position:absolute;inset:0;background:#fff;display:flex;flex-direction:column;font-family:'Amiri',Georgia,serif}
  .charme-modal__topbar{position:relative;flex:0 0 auto;display:flex;align-items:center;justify-content:flex-start;gap:10px;min-height:56px;padding:8px 16px;border-bottom:1px solid #e4d8c7;background:#f4edda}
  .charme-back{display:inline-flex;align-items:center;gap:8px;font-family:'Azeret Mono',ui-monospace,monospace;font-size:15px;font-weight:500;line-height:normal;cursor:pointer;border:0;border-radius:0;background:transparent;color:#2e2a26;padding:8px 10px;z-index:1}
  .charme-back:hover{opacity:.65}
  .charme-back__arrow{font-size:18px;line-height:1}
  /* Charmé logo replaces the store menu, centred in the nav bar. */
  .charme-logo{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-family:'Amiri',Georgia,serif;font-size:23px;font-weight:700;letter-spacing:0;color:#2e2a26;white-space:nowrap;pointer-events:none}
  .charme-logo-img{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);max-height:40px;width:auto;pointer-events:none}
  .charme-modal__panel .charme-customizer{flex:1 1 auto;min-height:0}
  body.charme-modal-open{overflow:hidden}
  @media (max-width:480px){.charme-back__label{display:none}}
</style>

<script>
  (function () {
    var variantMap = { products: {}, charms: {} };
    try {
      variantMap = JSON.parse({{ cfg_variant_map | json }} || '{}');
    } catch (e) {
      console.error('[Charmé] Variant map is not valid JSON —', e);
    }
    window.CharmeConfig = {
      apiBase: {{ cfg_api_base | json }},
      uploadEndpoint: {{ cfg_api_base | append: '/api/upload-proof' | json }},
      orderMode: {{ cfg_order_mode | json }},
      variantMap: variantMap,
      cartRedirect: {{ cfg_cart_redir | json }},
      defaultGroup: {{ cfg_def_group | json }},
      defaultProductId: {{ cfg_def_product | strip | json }},
      {%- comment -%}
        Buyer language + presentment currency, forwarded from the storefront so the
        widget renders localised copy and buyer-local prices. `base` is the shop
        currency the catalogue prices are stored in; `active` is the buyer's
        chosen presentment currency. The live conversion RATE is read client-side
        from window.Shopify.currency.rate (injected by Shopify Markets); when the
        store is single-currency active === base and no conversion is applied.
      {%- endcomment -%}
      locale: {{ request.locale.iso_code | json }},
      currency: {
        base: {{ shop.currency | json }},
        active: {{ cart.currency.iso_code | default: shop.currency | json }},
        rate: {{ cart.currency.rate | default: 1 | json }}
      },
      country: {{ localization.country.iso_code | default: cart.currency.country.iso_code | json }},
      {%- comment -%} presets temporarily hidden {%- endcomment -%}
      {%- comment -%} presetHandle: {{ cfg_preset | strip | json }}, {%- endcomment -%}
      height: "100%",
      mountId: "charme-customizer-{{ uid }}",
      lazy: true,
      shop: {{ shop.permanent_domain | json }}
    };
  })();
</script>

{%- comment -%} Store fonts so the nav bar + widget match the theme typography even
  when the theme doesn't already load them. {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400;1,700&family=Azeret+Mono:wght@400;500;600&display=swap">
<link rel="stylesheet" href="{{ cfg_api_base }}/widget/charme-customizer.css">
<script src="{{ cfg_api_base }}/widget/charme-customizer.js" defer></script>

<script>
  (function () {
    var root = document.getElementById('charme-root-{{ uid }}');
    if (!root) return;
    var modal = root.querySelector('[data-charme-modal]');

    // Map the product page's variant selection (iPhone model + case/gel colour)
    // onto the customizer's product id + case/gel finish so it opens matching what
    // the customer picked on the previous page. variantId -> [ caseGelOption, modelOption ]
    var CHARME_VARIANTS = {
      {%- for v in product.variants -%}
      {{ v.id | json }}: [{{ v.option1 | json }}, {{ v.option2 | json }}]{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    };
    function slugModel(model) {
      if (!model) return '';
      var s = String(model).trim().toLowerCase();
      if (/^any other/.test(s)) return 'other';
      return s
        .replace(/\+/g, ' plus ')
        .replace(/\//g, ' ')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');
    }
    function mapVariant(caseGel, model) {
      var out = { product: slugModel(model) };
      if (caseGel) {
        out.caseColourId = /^black/i.test(caseGel) ? 'black' : 'white';
        out.gelColourId = /glitter/i.test(caseGel) ? 'glitter' : (/black/i.test(caseGel) ? 'black' : 'white');
      }
      return out;
    }
    function selectedVariantId() {
      var byUrl = new URLSearchParams(location.search).get('variant');
      if (byUrl && CHARME_VARIANTS[byUrl]) return byUrl;
      var input = document.querySelector('form[action*="/cart/add"] [name="id"], [name="id"]');
      if (input && CHARME_VARIANTS[input.value]) return input.value;
      var keys = Object.keys(CHARME_VARIANTS);
      return keys.length ? keys[0] : null;
    }
    function applySelectedVariant() {
      var vid = selectedVariantId();
      var opt = vid && CHARME_VARIANTS[vid];
      if (!opt || !window.CharmeConfig) return;
      var m = mapVariant(opt[0], opt[1]);
      if (m.product) window.CharmeConfig.defaultProductId = m.product;
      if (m.caseColourId) window.CharmeConfig.caseColourId = m.caseColourId;
      if (m.gelColourId) window.CharmeConfig.gelColourId = m.gelColourId;
      window.CharmeConfig.variantId = vid;
    }

    function ensureMounted(tries) {
      if (window.CharmeCustomizer && window.CharmeCustomizer.mount) {
        window.CharmeCustomizer.mount();
        window.dispatchEvent(new Event('resize'));
        return;
      }
      if (tries > 0) setTimeout(function () { ensureMounted(tries - 1); }, 80);
    }
    function open() {
      applySelectedVariant();
      // Portal the modal to <body> so its fixed, max z-index overlay truly covers
      // the whole page (incl. the sticky store header) regardless of whatever
      // stacking context the section it's rendered in creates.
      if (modal.parentNode !== document.body) document.body.appendChild(modal);
      modal.hidden = false;
      document.body.classList.add('charme-modal-open');
      ensureMounted(80);
      [0, 60, 200, 500].forEach(function (t) {
        setTimeout(function () { window.dispatchEvent(new Event('resize')); }, t);
      });
    }
    function close() {
      modal.hidden = true;
      document.body.classList.remove('charme-modal-open');
    }
    root.querySelectorAll('[data-charme-open]').forEach(function (b) { b.addEventListener('click', open); });
    root.querySelectorAll('[data-charme-close]').forEach(function (b) { b.addEventListener('click', close); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) close(); });

    // Arriving from a cart "Edit design" link (/products/<handle>?charme_edit=<key>)
    // → jump STRAIGHT into the editor instead of landing on the product page. The
    // widget reads ?charme_edit itself (entry.jsx) and loads that design's layout.
    try {
      if (!window.__charmeAutoOpened && new URLSearchParams(location.search).get('charme_edit')) {
        window.__charmeAutoOpened = true;
        open();
      }
    } catch (e) {}
  })();
</script>
