{%- comment -%}
  charme-bundles.liquid — "Bundle & save" blocks, driven by the Charmé admin.
  ---------------------------------------------------------------------------
  Paste anywhere (product page, cart page, a custom page section, etc.):

      {% render 'charme-bundles' %}

  Optional params:
      api_base    Cloudflare Pages base for the settings API
                  (default https://charme-customizer.pages.dev)
      bundle_name Render only the bundle whose campaign name matches (else all)
      redirect    'cart' (default) | 'drawer' | 'none' — where to go after claim

  It is fully linked to Shopify: it reads each bundle's product HANDLES from
  /api/settings, fetches LIVE product data + prices from Shopify (/products/<h>.js),
  and adds the chosen variants to the cart (/cart/add.js) on claim. On a PRODUCT
  page it only shows the bundles that involve the product being viewed; when
  several match they become a swipeable carousel. The saving is applied by the
  product-scoped Shopify AUTOMATIC discount created via "Save & sync to Shopify"
  (no code needed); if a bundle has a code, it is applied too.
{%- endcomment -%}

{%- assign _api = api_base | default: 'https://charme-customizer.pages.dev' -%}
{%- assign _redirect = redirect | default: 'cart' -%}

<div
  class="charme-bundles"
  data-charme-bundles
  data-api-base="{{ _api }}"
  data-only="{{ bundle_name | escape }}"
  data-redirect="{{ _redirect }}"
  data-routes-cart="{{ routes.cart_url }}"
>
  <div class="charme-bundles__loading">Loading offers…</div>
</div>

<style>
  .charme-bundles { margin: 16px 0; font-family: inherit; }
  .charme-bundles__loading { color: #8a7f74; font-size: 14px; text-align: center; }
  .cb-block { border: none; border-radius: 0; padding: 12px 0 16px; margin: 0 auto; background: transparent; width: 100%; max-width: 380px; box-sizing: border-box; }
  .cb-block__title { text-align: center; font-size: 19px; font-weight: 700; margin: 0 0 3px; color: #2e2a26; }
  .cb-block__sub { text-align: center; font-size: 13px; color: #8a7f74; margin: 0 0 12px; }
  .cb-claim { display: block; width: 100%; margin: 14px 0 0; border: none; border-radius: var(--cb-radius, 10px); background: var(--cb-accent, #2e2a26); color: #fff; padding: 13px 26px; font-weight: 600; font-size: 15px; cursor: pointer; }
  .cb-claim:disabled { opacity: .5; cursor: default; }
  .cb-summary { text-align: center; margin: 16px 0 6px; }
  .cb-summary__was { color: #8a7f74; text-decoration: line-through; margin-right: 8px; }
  .cb-summary__now { color: #2e7d32; font-weight: 700; font-size: 18px; }
  .cb-err { color: #b35b5b; font-size: 13px; text-align: center; }
  .cb-badge { display:inline-block; background:var(--cb-badge-bg, #f2e7d8); color:var(--cb-badge-ink, #8a5a2b); font-size:11px; font-weight:700; border-radius:999px; padding:2px 9px; }

  /* Layout 1 — Frequently bought together: a horizontal row with + separators
     and a checkbox per product. */
  .cb-fbt { display: flex; align-items: stretch; justify-content: center; flex-wrap: wrap; gap: 10px; }
  .cb-plus { align-self: center; font-size: 22px; font-weight: 700; color: #b0a693; }
  .cb-fbt__card { position: relative; flex: 1 1 150px; max-width: 200px; border: 1px solid rgba(190,170,140,0.35); border-radius: var(--cb-radius, 12px); padding: 10px; text-align: center; display: flex; flex-direction: column; gap: 8px; background: var(--cb-card-bg, rgba(255,255,255,0.45)); }
  .cb-fbt__check { position: absolute; top: 8px; left: 8px; width: 18px; height: 18px; accent-color: #b35b5b; }
  .cb-card__img { width: 100%; height: 100px; object-fit: contain; border-radius: 8px; background: #faf5ec; }
  .cb-card__name { font-size: 12.5px; line-height: 1.25; color: #2e2a26; min-height: 30px; }
  .cb-card__price { font-size: 13px; color: #2e2a26; }
  .cb-fbt__card select { width: 100%; max-width: 100%; box-sizing: border-box; font: inherit; font-size: 12px; padding: 4px 6px; border: 1px solid #e4d8c7; border-radius: 6px; text-overflow: ellipsis; }

  /* Layout 2 — Volume discount: stacked quantity tiers. */
  .cb-vol { display: flex; flex-direction: column; gap: 8px; width: 100%; }
  .cb-vol__tier { display: flex; align-items: center; justify-content: space-between; border: 1.5px solid rgba(190,170,140,0.4); border-radius: var(--cb-radius, 12px); padding: 11px 15px; cursor: pointer; background: var(--cb-card-bg, rgba(255,255,255,0.5)); }
  .cb-vol__tier.is-active { border-color: #b35b5b; box-shadow: 0 0 0 2px rgba(179,91,91,.15); }
  .cb-vol__tier .cb-vol__q { font-weight: 700; }
  .cb-vol__save { color: #2e7d32; font-weight: 600; font-size: 12px; }
  .cb-vol__was { color:#8a7f74; text-decoration: line-through; margin-right: 8px; font-size: 13px; }

  /* Layout 3 — Mix & match: a grid of products with +/- steppers + a live basket bar. */
  .cb-mix { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
  .cb-mix__card { border: 1px solid rgba(190,170,140,0.35); border-radius: var(--cb-radius, 12px); padding: 10px; text-align: center; display: flex; flex-direction: column; gap: 6px; background: var(--cb-card-bg, rgba(255,255,255,0.45)); }
  .cb-step { display: inline-flex; align-items: center; gap: 8px; justify-content: center; }
  .cb-step button { width: 26px; height: 26px; border-radius: 50%; border: 1px solid #e4d8c7; background: #fff; font-size: 16px; line-height: 1; cursor: pointer; }
  .cb-step span { min-width: 20px; font-weight: 600; }
  .cb-mix__bar { position: sticky; bottom: 0; margin-top: 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px; background: rgba(250,245,236,0.85); backdrop-filter: blur(4px); border: 1px solid rgba(190,170,140,0.35); border-radius: 12px; padding: 10px 14px; }
  .cb-mix__bar .cb-claim { margin: 0; width: auto; }

  /* Layout 4 — Pick any (mix quantity): numbered slots you fill from a dropdown. */
  .cb-pick { width: 100%; display: flex; flex-direction: column; gap: 8px; }
  .cb-pick__slot { display: flex; align-items: center; gap: 12px; border: 1px solid rgba(190,170,140,0.35); border-radius: var(--cb-radius, 12px); padding: 10px 14px; background: var(--cb-card-bg, rgba(255,255,255,0.45)); }
  .cb-pick__num { width: 26px; height: 26px; border-radius: 50%; background: #2e2a26; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; flex: none; }
  .cb-pick__thumb { width: 44px; height: 44px; flex: none; border-radius: 8px; object-fit: contain; background: #faf5ec; border: 1px solid rgba(190,170,140,0.3); }
  .cb-pick__thumb:not(.is-set) { visibility: hidden; }
  .cb-pick__slot select { flex: 1; font: inherit; padding: 6px 8px; border: 1px solid #e4d8c7; border-radius: 8px; }

  /* Layout 5 — Match & swipe: fixed main product + a swipeable match card. */
  .cb-swipe { display: flex; align-items: stretch; justify-content: center; flex-wrap: wrap; gap: 10px; }
  .cb-swipe__card { position: relative; flex: 1 1 150px; max-width: 210px; border: 1px solid rgba(190,170,140,0.35); border-radius: var(--cb-radius, 12px); padding: 10px; text-align: center; display: flex; flex-direction: column; gap: 8px; background: var(--cb-card-bg, rgba(255,255,255,0.45)); }
  .cb-swipe__tag { font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #b0a693; }
  .cb-swipe__arrows { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; }
  .cb-swipe__arrow { width: 30px; height: 30px; border-radius: 50%; border: 1px solid #e4d8c7; background: #fff; font-size: 17px; line-height: 1; cursor: pointer; color: #2e2a26; }
  .cb-swipe__arrow:hover { background: #faf5ec; }
  .cb-swipe__dots { display: inline-flex; gap: 4px; align-items: center; }
  .cb-swipe__dot { width: 6px; height: 6px; border-radius: 50%; background: #e4d8c7; display: inline-block; }
  .cb-swipe__dot.is-on { background: var(--cb-accent, #2e2a26); }

  /* Carousel — multiple bundles relevant to the current product page. */
  .cb-carousel { max-width: 380px; margin: 0 auto; }
  .cb-carousel__nav { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 6px; }
  .cb-carousel__arrow { width: 32px; height: 32px; border-radius: 50%; border: 1px solid #e4d8c7; background: #fff; font-size: 18px; line-height: 1; cursor: pointer; color: #2e2a26; }
  .cb-carousel__arrow:hover { background: #faf5ec; }
  .cb-carousel__dots { display: inline-flex; gap: 5px; align-items: center; }
  .cb-carousel__dot { width: 7px; height: 7px; border-radius: 50%; background: #e4d8c7; display: inline-block; }
  .cb-carousel__dot.is-on { background: #2e2a26; }
</style>

<script>
(function () {
  var roots = document.querySelectorAll('[data-charme-bundles]');
  if (!roots.length) return;
  var _colCache = {};

  function money(cents) { return '£' + (cents / 100).toFixed(2); }
  function pct(bundle) { return Number(bundle.value) || 0; }
  function isFixed(bundle) { return (bundle.discountKind || 'percent') === 'fixed'; }
  function discounted(cents, bundle) {
    if (isFixed(bundle)) return Math.round((Number(bundle.value) || 0) * 100);
    return Math.round(cents * (1 - pct(bundle) / 100));
  }
  function dealBadge(bundle) { return isFixed(bundle) ? ('£' + (Number(bundle.value) || 0) + ' bundle') : ('Save ' + pct(bundle) + '%'); }

  async function getProduct(handle) {
    var res = await fetch('/products/' + encodeURIComponent(handle) + '.js', { headers: { Accept: 'application/json' } });
    if (!res.ok) throw new Error('product not found: ' + handle);
    return res.json();
  }
  async function getCollectionProducts(handle) {
    // Storefront AJAX: up to 250 published products for a collection (cached per handle).
    if (_colCache[handle]) return _colCache[handle];
    var res = await fetch('/collections/' + encodeURIComponent(handle) + '/products.json?limit=250', { headers: { Accept: 'application/json' } });
    var list = res.ok ? (((await res.json()) || {}).products || []) : [];
    _colCache[handle] = list;
    return list;
  }
  function firstAvailableVariant(p) { return (p.variants || []).find(function (v) { return v.available; }) || (p.variants || [])[0]; }
  // /products/<h>.js gives price in CENTS (number); /collections/..products.json gives "48.00" (string).
  function vPrice(v) { var p = v && v.price; if (typeof p === 'number') return p; var n = parseFloat(p); return isNaN(n) ? 0 : Math.round(n * 100); }
  function imgOf(p) {
    var f = p.featured_image;
    if (f) return typeof f === 'string' ? f : (f.src || f.url || '');
    var im = p.images && p.images[0];
    if (!im) return '';
    return typeof im === 'string' ? im : (im.src || im.url || '');
  }
  function titleOf(p) { return p.title || p.handle || ''; }
  function currentHandle() { var m = (location.pathname || '').match(/\/products\/([^/?#]+)/); return m ? m[1] : ''; }
  function applyStyle(block, bundle) {
    var st = bundle.style || {};
    if (st.accent) block.style.setProperty('--cb-accent', st.accent);
    if (st.cardBg) block.style.setProperty('--cb-card-bg', st.cardBg);
    if (st.badgeBg) block.style.setProperty('--cb-badge-bg', st.badgeBg);
    if (st.badgeInk) block.style.setProperty('--cb-badge-ink', st.badgeInk);
    if (st.radius != null) block.style.setProperty('--cb-radius', st.radius + 'px');
  }
  // Resolve one "side" of a swipe bundle (specific products OR a whole collection).
  async function resolveSide(side) {
    side = side || {};
    if (side.mode === 'collection' && side.collection && side.collection.handle) {
      return await getCollectionProducts(side.collection.handle);
    }
    var handles = (side.products || []).map(function (p) { return (p.handle || '').trim(); }).filter(Boolean);
    var res = await Promise.all(handles.map(function (h) { return getProduct(h).catch(function () { return null; }); }));
    return res.filter(Boolean);
  }
  // The anchor-first model: `target` = what the offer is FOR (drives which product
  // pages show it + the main item); `partner` = what to bundle it WITH. Legacy
  // bundles used main/match/items — fall back to those.
  function sideOf(bundle, which) {
    if (which === 'target') return bundle.target || bundle.main || { mode: 'products', products: bundle.items || [], collection: null };
    return bundle.partner || bundle.match || { mode: 'products', products: [], collection: null };
  }
  function dedupProducts(arr) { var seen = {}; return arr.filter(function (p) { if (!p || seen[p.handle]) return false; seen[p.handle] = true; return true; }); }
  // Is `handle` one of the products a bundle side points at (product list or collection)?
  async function productInSide(side, handle) {
    side = side || {};
    if (side.mode === 'collection' && side.collection && side.collection.handle) {
      var prods = await getCollectionProducts(side.collection.handle);
      return prods.some(function (p) { return p.handle === handle; });
    }
    return (side.products || []).some(function (p) { return (p.handle || '').trim() === handle; });
  }
  // Show an offer on a product page only when the product being viewed is part of
  // its target. (No product context — cart / custom page — shows every active offer.)
  async function bundleRelevant(bundle, handle) {
    if (!handle) return true;
    return await productInSide(sideOf(bundle, 'target'), handle);
  }

  async function addToCart(items) {
    if (!items.length) return;
    await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: items }) });
  }
  async function applyCodeAndGo(root, code) {
    var redirect = root.getAttribute('data-redirect') || 'cart';
    var cart = root.getAttribute('data-routes-cart') || '/cart';
    if (redirect === 'none') { document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true })); return; }
    window.location.href = code ? ('/discount/' + encodeURIComponent(code) + '?redirect=' + encodeURIComponent(cart)) : cart;
  }
  function el(tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; }
  function claimBtn(bundle) { var b = el('button', 'cb-claim', bundle.claimText || 'Claim this offer'); b.type = 'button'; return b; }
  function subtitle(text) { return el('div', 'cb-block__sub', text); }

  async function doClaim(root, block, bundle, claim, items) {
    if (!items.length) return;
    var label = claim.textContent; claim.disabled = true; claim.textContent = 'Adding…';
    try { await addToCart(items); await applyCodeAndGo(root, bundle.code); }
    catch (e) { claim.disabled = false; claim.textContent = label; block.appendChild(el('div', 'cb-err', 'Sorry, could not add the bundle.')); }
  }

  // ---- Layout 1: Frequently bought together (row + checkboxes + "+") -------
  function renderFBT(root, block, bundle, products) {
    block.appendChild(subtitle('Buy these together and save — untick anything you don\u2019t want.'));
    var row = el('div', 'cb-fbt');
    var checked = {}, selected = {}, byHandle = {};
    products.forEach(function (p, i) {
      var v = firstAvailableVariant(p); if (!v) return;
      checked[p.handle] = true; selected[p.handle] = v.id; byHandle[p.handle] = p;
      if (i > 0) row.appendChild(el('span', 'cb-plus', '+'));
      var card = el('div', 'cb-fbt__card');
      var cb = el('input', 'cb-fbt__check'); cb.type = 'checkbox'; cb.checked = true;
      cb.addEventListener('change', function () { checked[p.handle] = cb.checked; recompute(); });
      card.appendChild(cb);
      var img = el('img', 'cb-card__img'); img.src = imgOf(p); img.alt = p.title; card.appendChild(img);
      card.appendChild(el('div', 'cb-card__name', p.title));
      if (bundle.showVariants !== false && (p.variants || []).length > 1) {
        var sel = document.createElement('select');
        p.variants.forEach(function (vr) { var o = el('option', null, vr.title + ' \u2014 ' + money(vPrice(vr))); o.value = vr.id; if (!vr.available) o.disabled = true; sel.appendChild(o); });
        sel.value = v.id;
        sel.addEventListener('change', function () { selected[p.handle] = sel.value; recompute(); });
        card.appendChild(sel);
      } else { card.appendChild(el('div', 'cb-card__price', money(vPrice(v)))); }
      row.appendChild(card);
    });
    block.appendChild(row);
    var summary = el('div', 'cb-summary'); block.appendChild(summary);
    var claim = claimBtn(bundle); block.appendChild(claim);
    function items() {
      return Object.keys(checked).filter(function (h) { return checked[h]; }).map(function (h) {
        var p = byHandle[h]; var vr = (p.variants || []).find(function (x) { return String(x.id) === String(selected[h]); });
        return { id: vr.id, price: vPrice(vr) };
      });
    }
    function recompute() {
      var its = items(); var orig = its.reduce(function (s, x) { return s + x.price; }, 0); var now = discounted(orig, bundle);
      summary.innerHTML = its.length ? ('<span class="cb-summary__was">' + money(orig) + '</span><span class="cb-summary__now">' + money(now) + '</span>') : '<span class="cb-block__sub">Select at least one item</span>';
      claim.disabled = its.length === 0;
    }
    recompute();
    claim.addEventListener('click', function () { doClaim(root, block, bundle, claim, items().map(function (x) { return { id: x.id, quantity: 1 }; })); });
  }

  // ---- Layout 2: Volume discount (quantity tiers of one product) ----------
  function renderVolume(root, block, bundle, products) {
    var p = products[0]; if (!p) return;
    var v = firstAvailableVariant(p); if (!v) return;
    block.appendChild(subtitle('The more of ' + p.title + ' you buy, the more you save.'));
    var chosen = 2;
    var wrap = el('div', 'cb-vol'); block.appendChild(wrap);
    var claim = claimBtn(bundle); block.appendChild(claim);
    function saveAt(n) { return n <= 1 ? 0 : (isFixed(bundle) ? 0 : Math.round(pct(bundle) * (n === 2 ? 0.66 : 1))); }
    function draw() {
      wrap.innerHTML = '';
      [1, 2, 3].forEach(function (n) {
        var save = saveAt(n); var was = vPrice(v) * n;
        var price = (isFixed(bundle) && n >= 2) ? Math.round(discounted(was, bundle)) : Math.round(was * (1 - save / 100));
        var tier = el('div', 'cb-vol__tier' + (n === chosen ? ' is-active' : ''));
        tier.innerHTML = '<span><span class="cb-vol__q">' + ['One', 'Two', 'Three'][n - 1] + '</span>' + (save ? ' <span class="cb-vol__save">Save ' + save + '%</span>' : ' <span class="cb-vol__save" style="color:#8a7f74">Standard price</span>') + '</span><span>' + (save ? '<span class="cb-vol__was">' + money(was) + '</span>' : '') + money(price) + '</span>';
        tier.addEventListener('click', function () { chosen = n; draw(); });
        wrap.appendChild(tier);
      });
    }
    draw();
    claim.addEventListener('click', function () { doClaim(root, block, bundle, claim, [{ id: v.id, quantity: chosen }]); });
  }

  // ---- Layout 3: Mix & match (grid + steppers + live basket bar) -----------
  function renderMixMatch(root, block, bundle, products) {
    block.appendChild(subtitle('Build your own bundle \u2014 add any mix, the discount applies to the lot.'));
    var grid = el('div', 'cb-mix'); block.appendChild(grid);
    var qty = {}, sel = {}, byHandle = {};
    products.forEach(function (p) {
      var v = firstAvailableVariant(p); if (!v) return;
      qty[p.handle] = 0; sel[p.handle] = v.id; byHandle[p.handle] = p;
      var card = el('div', 'cb-mix__card');
      var img = el('img', 'cb-card__img'); img.src = imgOf(p); img.alt = p.title; card.appendChild(img);
      card.appendChild(el('div', 'cb-card__name', p.title));
      card.appendChild(el('div', 'cb-card__price', money(vPrice(v))));
      var step = el('div', 'cb-step');
      var minus = el('button', null, '\u2212'); minus.type = 'button';
      var count = el('span', null, '0');
      var plus = el('button', null, '+'); plus.type = 'button';
      minus.addEventListener('click', function () { qty[p.handle] = Math.max(0, qty[p.handle] - 1); count.textContent = qty[p.handle]; recompute(); });
      plus.addEventListener('click', function () { qty[p.handle] += 1; count.textContent = qty[p.handle]; recompute(); });
      step.appendChild(minus); step.appendChild(count); step.appendChild(plus);
      card.appendChild(step);
      grid.appendChild(card);
    });
    var bar = el('div', 'cb-mix__bar'); block.appendChild(bar);
    var totals = el('div'); var claim = claimBtn(bundle);
    bar.appendChild(totals); bar.appendChild(claim);
    function items() { return Object.keys(qty).filter(function (h) { return qty[h] > 0; }).map(function (h) { var p = byHandle[h]; var vr = (p.variants || []).find(function (x) { return String(x.id) === String(sel[h]); }); return { id: vr.id, quantity: qty[h], price: vPrice(vr) }; }); }
    function recompute() {
      var its = items(); var count = its.reduce(function (s, x) { return s + x.quantity; }, 0);
      var orig = its.reduce(function (s, x) { return s + x.price * x.quantity; }, 0); var now = discounted(orig, bundle);
      totals.innerHTML = '<div><strong>' + count + '</strong> item' + (count === 1 ? '' : 's') + '</div>' + (count ? '<div><span class="cb-summary__was">' + money(orig) + '</span><span class="cb-summary__now">' + money(now) + '</span></div>' : '<div class="cb-block__sub">Add products to start</div>');
      claim.disabled = count === 0;
    }
    recompute();
    claim.addEventListener('click', function () { doClaim(root, block, bundle, claim, items().map(function (x) { return { id: x.id, quantity: x.quantity }; })); });
  }

  // ---- Layout 4: Pick any (numbered slots you fill from a dropdown) --------
  function renderPickAny(root, block, bundle, products) {
    var slots = Math.max(2, (bundle.items || []).length || products.length);
    block.appendChild(subtitle('Pick any ' + slots + ' \u2014 ' + (isFixed(bundle) ? ('bundle for \u00a3' + (Number(bundle.value) || 0)) : ('save ' + pct(bundle) + '%')) + '.'));
    var wrap = el('div', 'cb-pick'); block.appendChild(wrap);
    var pick = [];
    for (var i = 0; i < slots; i++) (function (i) {
      var slot = el('div', 'cb-pick__slot');
      slot.appendChild(el('span', 'cb-pick__num', String(i + 1)));
      var thumb = el('img', 'cb-pick__thumb'); thumb.alt = ''; thumb.loading = 'lazy';
      slot.appendChild(thumb);
      var s = document.createElement('select');
      s.appendChild(el('option', null, 'Pick a product\u2026'));
      products.forEach(function (p) { var v = firstAvailableVariant(p); if (!v) return; var o = el('option', null, p.title + ' \u2014 ' + money(vPrice(v))); o.value = p.handle; s.appendChild(o); });
      s.addEventListener('change', function () {
        pick[i] = s.value || null;
        var p = products.find(function (x) { return x.handle === s.value; });
        var src = p ? imgOf(p) : '';
        if (src) { thumb.src = src; thumb.classList.add('is-set'); }
        else { thumb.removeAttribute('src'); thumb.classList.remove('is-set'); }
        recompute();
      });
      slot.appendChild(s); wrap.appendChild(slot); pick[i] = null;
    })(i);
    var summary = el('div', 'cb-summary'); block.appendChild(summary);
    var claim = claimBtn(bundle); block.appendChild(claim);
    function chosen() { return pick.filter(Boolean).map(function (h) { var p = products.find(function (x) { return x.handle === h; }); var v = firstAvailableVariant(p); return { id: v.id, price: vPrice(v) }; }); }
    function recompute() {
      var c = chosen(); var orig = c.reduce(function (s, x) { return s + x.price; }, 0); var now = discounted(orig, bundle);
      summary.innerHTML = c.length ? ('<span class="cb-summary__was">' + money(orig) + '</span><span class="cb-summary__now">' + money(now) + '</span>') : '<span class="cb-block__sub">Fill the slots above</span>';
      claim.disabled = c.length < slots;
    }
    recompute();
    claim.addEventListener('click', function () { doClaim(root, block, bundle, claim, chosen().map(function (x) { return { id: x.id, quantity: 1 }; })); });
  }

  // ---- Layout 5: Match & swipe (fixed main product + swipeable match) ------
  // `main` = the anchor product (already resolved), `matchList` = the add-ons pool.
  function renderSwipe(root, block, bundle, main, matchList) {
    var mv = firstAvailableVariant(main);

    block.appendChild(subtitle(bundle.subtitle || 'Swipe to find your match \u2014 then add both and save.'));
    var row = el('div', 'cb-swipe'); block.appendChild(row);

    // Fixed main card
    var mainCard = el('div', 'cb-swipe__card');
    mainCard.appendChild(el('div', 'cb-swipe__tag', 'Your pick'));
    var mImg = el('img', 'cb-card__img'); mImg.alt = ''; mImg.src = imgOf(main); mainCard.appendChild(mImg);
    mainCard.appendChild(el('div', 'cb-card__name', titleOf(main)));
    mainCard.appendChild(el('div', 'cb-card__price', money(vPrice(mv))));
    row.appendChild(mainCard);

    row.appendChild(el('div', 'cb-plus', '+'));

    // Swipeable match card
    var idx = 0;
    var matchCard = el('div', 'cb-swipe__card');
    matchCard.appendChild(el('div', 'cb-swipe__tag', 'Match'));
    var xImg = el('img', 'cb-card__img'); xImg.alt = ''; matchCard.appendChild(xImg);
    var xName = el('div', 'cb-card__name'); matchCard.appendChild(xName);
    var xPrice = el('div', 'cb-card__price'); matchCard.appendChild(xPrice);
    var arrows = el('div', 'cb-swipe__arrows');
    var prev = el('button', 'cb-swipe__arrow', '\u2039'); prev.type = 'button'; prev.setAttribute('aria-label', 'Previous match');
    var next = el('button', 'cb-swipe__arrow', '\u203a'); next.type = 'button'; next.setAttribute('aria-label', 'Next match');
    var dots = el('div', 'cb-swipe__dots');
    arrows.appendChild(prev); arrows.appendChild(dots); arrows.appendChild(next);
    matchCard.appendChild(arrows);
    row.appendChild(matchCard);

    var summary = el('div', 'cb-summary'); block.appendChild(summary);
    var claim = claimBtn(bundle); block.appendChild(claim);

    function paintDots() {
      dots.innerHTML = '';
      var n = Math.min(matchList.length, 8);
      for (var i = 0; i < n; i++) { dots.appendChild(el('span', 'cb-swipe__dot' + (i === (idx % n) ? ' is-on' : ''))); }
    }
    function render() {
      var m = matchList[idx];
      var v = firstAvailableVariant(m);
      xImg.src = imgOf(m); xName.textContent = titleOf(m); xPrice.textContent = money(vPrice(v));
      var orig = vPrice(mv) + vPrice(v);
      var now = discounted(orig, bundle);
      summary.innerHTML = '<span class="cb-summary__was">' + money(orig) + '</span><span class="cb-summary__now">' + money(now) + '</span>';
      claim.disabled = !mv || !v;
      paintDots();
    }
    function go(step) { idx = (idx + step + matchList.length) % matchList.length; render(); }
    prev.addEventListener('click', function () { go(-1); });
    next.addEventListener('click', function () { go(1); });
    // Touch swipe on the match card
    var sx = null;
    matchCard.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; }, { passive: true });
    matchCard.addEventListener('touchend', function (e) { if (sx == null) return; var dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 30) go(dx < 0 ? 1 : -1); sx = null; });
    render();

    claim.addEventListener('click', function () {
      var mvNow = firstAvailableVariant(main);
      var xvNow = firstAvailableVariant(matchList[idx]);
      if (!mvNow || !xvNow) return;
      doClaim(root, block, bundle, claim, [{ id: mvNow.id, quantity: 1 }, { id: xvNow.id, quantity: 1 }]);
    });
    return true;
  }

  async function buildBundle(root, bundle) {
    var targetProducts = await resolveSide(sideOf(bundle, 'target'));
    if (!targetProducts.length) {
      console.warn('[Charmé bundles] offer "' + (bundle.name || bundle.blockTitle || '') + '" has no live target products — nothing to show.');
      return null;
    }
    var partnerProducts = await resolveSide(sideOf(bundle, 'partner'));
    // The anchor stays fixed: the current product page's product if it's in the
    // target set, else the first target product.
    var curr = currentHandle();
    var anchor = targetProducts.find(function (p) { return p.handle === curr; }) || targetProducts[0];
    var pool = dedupProducts([anchor].concat(partnerProducts));

    var layout = bundle.layout || 'swipe';
    var block = el('div', 'cb-block'); applyStyle(block, bundle);
    var title = el('div', 'cb-block__title');
    title.innerHTML = (bundle.blockTitle || 'Bundle & save') + ' <span class="cb-badge">' + dealBadge(bundle) + '</span>';
    block.appendChild(title);

    if (layout === 'swipe') {
      if (!partnerProducts.length) {
        console.warn('[Charmé bundles] swipe offer "' + (bundle.name || '') + '" has no partner products to swipe.');
        return null;
      }
      renderSwipe(root, block, bundle, anchor, partnerProducts);
    } else if (layout === 'volume') {
      renderVolume(root, block, bundle, [anchor]);
    } else if (layout === 'mixmatch') {
      renderMixMatch(root, block, bundle, pool);
    } else if (layout === 'pickany') {
      renderPickAny(root, block, bundle, pool);
    } else {
      renderFBT(root, block, bundle, pool);
    }
    return block;
  }

  // Several relevant bundles on one page → a swipeable / paged carousel.
  function mountCarousel(root, blocks) {
    if (blocks.length === 1) { root.appendChild(blocks[0]); return; }
    var wrap = el('div', 'cb-carousel');
    var viewport = el('div', 'cb-carousel__viewport');
    blocks.forEach(function (b, i) { b.classList.add('cb-carousel__slide'); if (i !== 0) b.style.display = 'none'; viewport.appendChild(b); });
    var nav = el('div', 'cb-carousel__nav');
    var prev = el('button', 'cb-carousel__arrow', '\u2039'); prev.type = 'button'; prev.setAttribute('aria-label', 'Previous offer');
    var next = el('button', 'cb-carousel__arrow', '\u203a'); next.type = 'button'; next.setAttribute('aria-label', 'Next offer');
    var dots = el('div', 'cb-carousel__dots');
    nav.appendChild(prev); nav.appendChild(dots); nav.appendChild(next);
    var idx = 0;
    function paint() { dots.innerHTML = ''; blocks.forEach(function (_, i) { dots.appendChild(el('span', 'cb-carousel__dot' + (i === idx ? ' is-on' : ''))); }); }
    function show(n) { blocks[idx].style.display = 'none'; idx = (n + blocks.length) % blocks.length; blocks[idx].style.display = ''; paint(); }
    prev.addEventListener('click', function () { show(idx - 1); });
    next.addEventListener('click', function () { show(idx + 1); });
    // Touch swipe across the whole carousel
    var sx = null;
    viewport.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; }, { passive: true });
    viewport.addEventListener('touchend', function (e) { if (sx == null) return; var dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 40) show(idx + (dx < 0 ? 1 : -1)); sx = null; });
    paint();
    wrap.appendChild(viewport); wrap.appendChild(nav);
    root.appendChild(wrap);
  }

  roots.forEach(async function (root) {
    var apiBase = (root.getAttribute('data-api-base') || '').replace(/\/$/, '');
    var only = (root.getAttribute('data-only') || '').trim();
    try {
      var res = await fetch(apiBase + '/api/settings', { headers: { Accept: 'application/json' } });
      var settings = res.ok ? await res.json() : {};
      var bundles = ((settings.discounts || {}).bundles || []).filter(function (b) { return b.active !== false; });
      if (only) bundles = bundles.filter(function (b) { return (b.name || '') === only; });
      // On a product page, keep only the bundles that involve the current product.
      var handle = currentHandle();
      var toShow = bundles;
      if (!only && handle) {
        toShow = [];
        for (var k = 0; k < bundles.length; k++) { if (await bundleRelevant(bundles[k], handle)) toShow.push(bundles[k]); }
      }
      var blocks = [];
      for (var i = 0; i < toShow.length; i++) { var b = await buildBundle(root, toShow[i]); if (b) blocks.push(b); }
      root.innerHTML = '';
      if (!blocks.length) { root.style.display = 'none'; return; }
      mountCarousel(root, blocks);
    } catch (e) { root.style.display = 'none'; }
  });
})();
</script>
