{%- comment -%}
  charme-bundles.liquid — "Bundle & save" blocks, driven by the Charmé admin.
  ---------------------------------------------------------------------------
  Paste anywhere (product page, cart page, a custom page section, etc.):

      {% render 'charme-bundles' %}

  Optional params:
      api_base    Cloudflare Pages base for the settings API
                  (default https://charme-customizer.pages.dev)
      bundle_name Render only the bundle whose campaign name matches (else all)
      redirect    'cart' (default) | 'drawer' | 'none' — where to go after claim

  It is fully linked to Shopify: it reads each bundle's product HANDLES from
  /api/settings, fetches LIVE product data + prices from Shopify (/products/<h>.js),
  and adds the chosen variants to the cart (/cart/add.js) on claim. The saving is
  applied by the product-scoped Shopify AUTOMATIC discount created via "Save &
  sync to Shopify" (no code needed); if a bundle has a code, it is applied too.
{%- endcomment -%}

{%- assign _api = api_base | default: 'https://charme-customizer.pages.dev' -%}
{%- assign _redirect = redirect | default: 'cart' -%}

<div
  class="charme-bundles"
  data-charme-bundles
  data-api-base="{{ _api }}"
  data-only="{{ bundle_name | escape }}"
  data-redirect="{{ _redirect }}"
  data-routes-cart="{{ routes.cart_url }}"
>
  <div class="charme-bundles__loading">Loading offers…</div>
</div>

<style>
  .charme-bundles { margin: 16px 0; font-family: inherit; }
  .charme-bundles__loading { color: #8a7f74; font-size: 14px; text-align: center; }
  .cb-block { border: none; border-radius: 0; padding: 12px 0 16px; margin: 0 auto; background: transparent; width: 100%; max-width: 380px; box-sizing: border-box; }
  .cb-block__title { text-align: center; font-size: 19px; font-weight: 700; margin: 0 0 3px; color: #2e2a26; }
  .cb-block__sub { text-align: center; font-size: 13px; color: #8a7f74; margin: 0 0 12px; }
  .cb-claim { display: block; width: 100%; margin: 14px 0 0; border: none; border-radius: 10px; background: #2e2a26; color: #fff; padding: 13px 26px; font-weight: 600; font-size: 15px; cursor: pointer; }
  .cb-claim:disabled { opacity: .5; cursor: default; }
  .cb-summary { text-align: center; margin: 16px 0 6px; }
  .cb-summary__was { color: #8a7f74; text-decoration: line-through; margin-right: 8px; }
  .cb-summary__now { color: #2e7d32; font-weight: 700; font-size: 18px; }
  .cb-err { color: #b35b5b; font-size: 13px; text-align: center; }
  .cb-badge { display:inline-block; background:#f2e7d8; color:#8a5a2b; font-size:11px; font-weight:700; border-radius:999px; padding:2px 9px; }

  /* Layout 1 — Frequently bought together: a horizontal row with + separators
     and a checkbox per product. */
  .cb-fbt { display: flex; align-items: stretch; justify-content: center; flex-wrap: wrap; gap: 10px; }
  .cb-plus { align-self: center; font-size: 22px; font-weight: 700; color: #b0a693; }
  .cb-fbt__card { position: relative; flex: 1 1 150px; max-width: 200px; border: 1px solid rgba(190,170,140,0.35); border-radius: 12px; padding: 10px; text-align: center; display: flex; flex-direction: column; gap: 8px; background: rgba(255,255,255,0.45); }
  .cb-fbt__check { position: absolute; top: 8px; left: 8px; width: 18px; height: 18px; accent-color: #b35b5b; }
  .cb-card__img { width: 100%; height: 100px; object-fit: contain; border-radius: 8px; background: #faf5ec; }
  .cb-card__name { font-size: 12.5px; line-height: 1.25; color: #2e2a26; min-height: 30px; }
  .cb-card__price { font-size: 13px; color: #2e2a26; }
  .cb-fbt__card select { width: 100%; max-width: 100%; box-sizing: border-box; font: inherit; font-size: 12px; padding: 4px 6px; border: 1px solid #e4d8c7; border-radius: 6px; text-overflow: ellipsis; }

  /* Layout 2 — Volume discount: stacked quantity tiers. */
  .cb-vol { display: flex; flex-direction: column; gap: 8px; width: 100%; }
  .cb-vol__tier { display: flex; align-items: center; justify-content: space-between; border: 1.5px solid rgba(190,170,140,0.4); border-radius: 12px; padding: 11px 15px; cursor: pointer; background: rgba(255,255,255,0.5); }
  .cb-vol__tier.is-active { border-color: #b35b5b; box-shadow: 0 0 0 2px rgba(179,91,91,.15); }
  .cb-vol__tier .cb-vol__q { font-weight: 700; }
  .cb-vol__save { color: #2e7d32; font-weight: 600; font-size: 12px; }
  .cb-vol__was { color:#8a7f74; text-decoration: line-through; margin-right: 8px; font-size: 13px; }

  /* Layout 3 — Mix & match: a grid of products with +/- steppers + a live basket bar. */
  .cb-mix { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
  .cb-mix__card { border: 1px solid rgba(190,170,140,0.35); border-radius: 12px; padding: 10px; text-align: center; display: flex; flex-direction: column; gap: 6px; background: rgba(255,255,255,0.45); }
  .cb-step { display: inline-flex; align-items: center; gap: 8px; justify-content: center; }
  .cb-step button { width: 26px; height: 26px; border-radius: 50%; border: 1px solid #e4d8c7; background: #fff; font-size: 16px; line-height: 1; cursor: pointer; }
  .cb-step span { min-width: 20px; font-weight: 600; }
  .cb-mix__bar { position: sticky; bottom: 0; margin-top: 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px; background: rgba(250,245,236,0.85); backdrop-filter: blur(4px); border: 1px solid rgba(190,170,140,0.35); border-radius: 12px; padding: 10px 14px; }
  .cb-mix__bar .cb-claim { margin: 0; width: auto; }

  /* Layout 4 — Pick any (mix quantity): numbered slots you fill from a dropdown. */
  .cb-pick { width: 100%; display: flex; flex-direction: column; gap: 8px; }
  .cb-pick__slot { display: flex; align-items: center; gap: 12px; border: 1px solid rgba(190,170,140,0.35); border-radius: 12px; padding: 10px 14px; background: rgba(255,255,255,0.45); }
  .cb-pick__num { width: 26px; height: 26px; border-radius: 50%; background: #2e2a26; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; flex: none; }
  .cb-pick__slot select { flex: 1; font: inherit; padding: 6px 8px; border: 1px solid #e4d8c7; border-radius: 8px; }
</style>

<script>
(function () {
  var roots = document.querySelectorAll('[data-charme-bundles]');
  if (!roots.length) return;

  function money(cents) { return '£' + (cents / 100).toFixed(2); }
  function pct(bundle) { return Number(bundle.value) || 0; }
  function isFixed(bundle) { return (bundle.discountKind || 'percent') === 'fixed'; }
  function discounted(cents, bundle) {
    if (isFixed(bundle)) return Math.round((Number(bundle.value) || 0) * 100);
    return Math.round(cents * (1 - pct(bundle) / 100));
  }
  function dealBadge(bundle) { return isFixed(bundle) ? ('£' + (Number(bundle.value) || 0) + ' bundle') : ('Save ' + pct(bundle) + '%'); }

  async function getProduct(handle) {
    var res = await fetch('/products/' + encodeURIComponent(handle) + '.js', { headers: { Accept: 'application/json' } });
    if (!res.ok) throw new Error('product not found: ' + handle);
    return res.json();
  }
  function firstAvailableVariant(p) { return (p.variants || []).find(function (v) { return v.available; }) || (p.variants || [])[0]; }
  function imgOf(p) { return p.featured_image || (p.images && p.images[0]) || ''; }

  async function addToCart(items) {
    if (!items.length) return;
    await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: items }) });
  }
  async function applyCodeAndGo(root, code) {
    var redirect = root.getAttribute('data-redirect') || 'cart';
    var cart = root.getAttribute('data-routes-cart') || '/cart';
    if (redirect === 'none') { document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true })); return; }
    window.location.href = code ? ('/discount/' + encodeURIComponent(code) + '?redirect=' + encodeURIComponent(cart)) : cart;
  }
  function el(tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; }
  function claimBtn(bundle) { var b = el('button', 'cb-claim', bundle.claimText || 'Claim this offer'); b.type = 'button'; return b; }
  function subtitle(text) { return el('div', 'cb-block__sub', text); }

  async function doClaim(root, block, bundle, claim, items) {
    if (!items.length) return;
    var label = claim.textContent; claim.disabled = true; claim.textContent = 'Adding…';
    try { await addToCart(items); await applyCodeAndGo(root, bundle.code); }
    catch (e) { claim.disabled = false; claim.textContent = label; block.appendChild(el('div', 'cb-err', 'Sorry, could not add the bundle.')); }
  }

  // ---- Layout 1: Frequently bought together (row + checkboxes + "+") -------
  function renderFBT(root, block, bundle, products) {
    block.appendChild(subtitle('Buy these together and save — untick anything you don\u2019t want.'));
    var row = el('div', 'cb-fbt');
    var checked = {}, selected = {}, byHandle = {};
    products.forEach(function (p, i) {
      var v = firstAvailableVariant(p); if (!v) return;
      checked[p.handle] = true; selected[p.handle] = v.id; byHandle[p.handle] = p;
      if (i > 0) row.appendChild(el('span', 'cb-plus', '+'));
      var card = el('div', 'cb-fbt__card');
      var cb = el('input', 'cb-fbt__check'); cb.type = 'checkbox'; cb.checked = true;
      cb.addEventListener('change', function () { checked[p.handle] = cb.checked; recompute(); });
      card.appendChild(cb);
      var img = el('img', 'cb-card__img'); img.src = imgOf(p); img.alt = p.title; card.appendChild(img);
      card.appendChild(el('div', 'cb-card__name', p.title));
      if (bundle.showVariants !== false && (p.variants || []).length > 1) {
        var sel = document.createElement('select');
        p.variants.forEach(function (vr) { var o = el('option', null, vr.title + ' \u2014 ' + money(vr.price)); o.value = vr.id; if (!vr.available) o.disabled = true; sel.appendChild(o); });
        sel.value = v.id;
        sel.addEventListener('change', function () { selected[p.handle] = sel.value; recompute(); });
        card.appendChild(sel);
      } else { card.appendChild(el('div', 'cb-card__price', money(v.price))); }
      row.appendChild(card);
    });
    block.appendChild(row);
    var summary = el('div', 'cb-summary'); block.appendChild(summary);
    var claim = claimBtn(bundle); block.appendChild(claim);
    function items() {
      return Object.keys(checked).filter(function (h) { return checked[h]; }).map(function (h) {
        var p = byHandle[h]; var vr = (p.variants || []).find(function (x) { return String(x.id) === String(selected[h]); });
        return { id: vr.id, price: vr.price };
      });
    }
    function recompute() {
      var its = items(); var orig = its.reduce(function (s, x) { return s + x.price; }, 0); var now = discounted(orig, bundle);
      summary.innerHTML = its.length ? ('<span class="cb-summary__was">' + money(orig) + '</span><span class="cb-summary__now">' + money(now) + '</span>') : '<span class="cb-block__sub">Select at least one item</span>';
      claim.disabled = its.length === 0;
    }
    recompute();
    claim.addEventListener('click', function () { doClaim(root, block, bundle, claim, items().map(function (x) { return { id: x.id, quantity: 1 }; })); });
  }

  // ---- Layout 2: Volume discount (quantity tiers of one product) ----------
  function renderVolume(root, block, bundle, products) {
    var p = products[0]; if (!p) return;
    var v = firstAvailableVariant(p); if (!v) return;
    block.appendChild(subtitle('The more of ' + p.title + ' you buy, the more you save.'));
    var chosen = 2;
    var wrap = el('div', 'cb-vol'); block.appendChild(wrap);
    var claim = claimBtn(bundle); block.appendChild(claim);
    function saveAt(n) { return n <= 1 ? 0 : (isFixed(bundle) ? 0 : Math.round(pct(bundle) * (n === 2 ? 0.66 : 1))); }
    function draw() {
      wrap.innerHTML = '';
      [1, 2, 3].forEach(function (n) {
        var save = saveAt(n); var was = v.price * n;
        var price = (isFixed(bundle) && n >= 2) ? Math.round(discounted(was, bundle)) : Math.round(was * (1 - save / 100));
        var tier = el('div', 'cb-vol__tier' + (n === chosen ? ' is-active' : ''));
        tier.innerHTML = '<span><span class="cb-vol__q">' + ['One', 'Two', 'Three'][n - 1] + '</span>' + (save ? ' <span class="cb-vol__save">Save ' + save + '%</span>' : ' <span class="cb-vol__save" style="color:#8a7f74">Standard price</span>') + '</span><span>' + (save ? '<span class="cb-vol__was">' + money(was) + '</span>' : '') + money(price) + '</span>';
        tier.addEventListener('click', function () { chosen = n; draw(); });
        wrap.appendChild(tier);
      });
    }
    draw();
    claim.addEventListener('click', function () { doClaim(root, block, bundle, claim, [{ id: v.id, quantity: chosen }]); });
  }

  // ---- Layout 3: Mix & match (grid + steppers + live basket bar) -----------
  function renderMixMatch(root, block, bundle, products) {
    block.appendChild(subtitle('Build your own bundle \u2014 add any mix, the discount applies to the lot.'));
    var grid = el('div', 'cb-mix'); block.appendChild(grid);
    var qty = {}, sel = {}, byHandle = {};
    products.forEach(function (p) {
      var v = firstAvailableVariant(p); if (!v) return;
      qty[p.handle] = 0; sel[p.handle] = v.id; byHandle[p.handle] = p;
      var card = el('div', 'cb-mix__card');
      var img = el('img', 'cb-card__img'); img.src = imgOf(p); img.alt = p.title; card.appendChild(img);
      card.appendChild(el('div', 'cb-card__name', p.title));
      card.appendChild(el('div', 'cb-card__price', money(v.price)));
      var step = el('div', 'cb-step');
      var minus = el('button', null, '\u2212'); minus.type = 'button';
      var count = el('span', null, '0');
      var plus = el('button', null, '+'); plus.type = 'button';
      minus.addEventListener('click', function () { qty[p.handle] = Math.max(0, qty[p.handle] - 1); count.textContent = qty[p.handle]; recompute(); });
      plus.addEventListener('click', function () { qty[p.handle] += 1; count.textContent = qty[p.handle]; recompute(); });
      step.appendChild(minus); step.appendChild(count); step.appendChild(plus);
      card.appendChild(step);
      grid.appendChild(card);
    });
    var bar = el('div', 'cb-mix__bar'); block.appendChild(bar);
    var totals = el('div'); var claim = claimBtn(bundle);
    bar.appendChild(totals); bar.appendChild(claim);
    function items() { return Object.keys(qty).filter(function (h) { return qty[h] > 0; }).map(function (h) { var p = byHandle[h]; var vr = (p.variants || []).find(function (x) { return String(x.id) === String(sel[h]); }); return { id: vr.id, quantity: qty[h], price: vr.price }; }); }
    function recompute() {
      var its = items(); var count = its.reduce(function (s, x) { return s + x.quantity; }, 0);
      var orig = its.reduce(function (s, x) { return s + x.price * x.quantity; }, 0); var now = discounted(orig, bundle);
      totals.innerHTML = '<div><strong>' + count + '</strong> item' + (count === 1 ? '' : 's') + '</div>' + (count ? '<div><span class="cb-summary__was">' + money(orig) + '</span><span class="cb-summary__now">' + money(now) + '</span></div>' : '<div class="cb-block__sub">Add products to start</div>');
      claim.disabled = count === 0;
    }
    recompute();
    claim.addEventListener('click', function () { doClaim(root, block, bundle, claim, items().map(function (x) { return { id: x.id, quantity: x.quantity }; })); });
  }

  // ---- Layout 4: Pick any (numbered slots you fill from a dropdown) --------
  function renderPickAny(root, block, bundle, products) {
    var slots = Math.max(2, (bundle.items || []).length || products.length);
    block.appendChild(subtitle('Pick any ' + slots + ' \u2014 ' + (isFixed(bundle) ? ('bundle for \u00a3' + (Number(bundle.value) || 0)) : ('save ' + pct(bundle) + '%')) + '.'));
    var wrap = el('div', 'cb-pick'); block.appendChild(wrap);
    var pick = [];
    for (var i = 0; i < slots; i++) (function (i) {
      var slot = el('div', 'cb-pick__slot');
      slot.appendChild(el('span', 'cb-pick__num', String(i + 1)));
      var s = document.createElement('select');
      s.appendChild(el('option', null, 'Pick a product\u2026'));
      products.forEach(function (p) { var v = firstAvailableVariant(p); if (!v) return; var o = el('option', null, p.title + ' \u2014 ' + money(v.price)); o.value = p.handle; s.appendChild(o); });
      s.addEventListener('change', function () { pick[i] = s.value || null; recompute(); });
      slot.appendChild(s); wrap.appendChild(slot); pick[i] = null;
    })(i);
    var summary = el('div', 'cb-summary'); block.appendChild(summary);
    var claim = claimBtn(bundle); block.appendChild(claim);
    function chosen() { return pick.filter(Boolean).map(function (h) { var p = products.find(function (x) { return x.handle === h; }); var v = firstAvailableVariant(p); return { id: v.id, price: v.price }; }); }
    function recompute() {
      var c = chosen(); var orig = c.reduce(function (s, x) { return s + x.price; }, 0); var now = discounted(orig, bundle);
      summary.innerHTML = c.length ? ('<span class="cb-summary__was">' + money(orig) + '</span><span class="cb-summary__now">' + money(now) + '</span>') : '<span class="cb-block__sub">Fill the slots above</span>';
      claim.disabled = c.length < slots;
    }
    recompute();
    claim.addEventListener('click', function () { doClaim(root, block, bundle, claim, chosen().map(function (x) { return { id: x.id, quantity: 1 }; })); });
  }

  async function renderBundle(root, container, bundle) {
    var handles = (bundle.items || []).map(function (it) { return (it.handle || '').trim(); }).filter(Boolean);
    if (!handles.length) return;
    // Resolve each product independently so ONE unpublished / 404 handle doesn't
    // kill the whole bundle — render with whatever is live on the storefront.
    var results = await Promise.all(handles.map(function (h) {
      return getProduct(h).catch(function () {
        console.warn('[Charmé bundles] product not available on storefront (skipped): ' + h);
        return null;
      });
    }));
    var products = results.filter(Boolean);
    if (!products.length) {
      console.warn('[Charmé bundles] bundle "' + (bundle.name || bundle.blockTitle || '') + '" has no products published to the Online Store — nothing to show.');
      return;
    }
    var block = el('div', 'cb-block');
    var title = el('div', 'cb-block__title');
    title.innerHTML = (bundle.blockTitle || 'Bundle & save') + ' <span class="cb-badge">' + dealBadge(bundle) + '</span>';
    block.appendChild(title);
    var layout = bundle.layout || 'fbt';
    if (layout === 'volume') renderVolume(root, block, bundle, products);
    else if (layout === 'mixmatch') renderMixMatch(root, block, bundle, products);
    else if (layout === 'pickany') renderPickAny(root, block, bundle, products);
    else renderFBT(root, block, bundle, products);
    container.appendChild(block);
  }

  roots.forEach(async function (root) {
    var apiBase = (root.getAttribute('data-api-base') || '').replace(/\/$/, '');
    var only = (root.getAttribute('data-only') || '').trim();
    try {
      var res = await fetch(apiBase + '/api/settings', { headers: { Accept: 'application/json' } });
      var settings = res.ok ? await res.json() : {};
      var bundles = ((settings.discounts || {}).bundles || []).filter(function (b) { return b.active !== false; });
      if (only) bundles = bundles.filter(function (b) { return (b.name || '') === only; });
      root.innerHTML = '';
      if (!bundles.length) { root.style.display = 'none'; return; }
      for (var i = 0; i < bundles.length; i++) { await renderBundle(root, root, bundles[i]); }
      if (!root.children.length) root.style.display = 'none';
    } catch (e) { root.style.display = 'none'; }
  });
})();
</script>
