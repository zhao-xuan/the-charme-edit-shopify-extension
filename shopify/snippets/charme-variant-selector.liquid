{%- comment -%}
  Admin-driven selector for the Custom phone case product.

  The visible controls are styled and grouped by /api/settings.variantSelector.
  Shopify's native Horizon variant-picker remains mounted as the source of truth:
  this snippet reads its current option values and dispatches changes back to it,
  so price, availability, URL, media, add-to-cart and extra options stay native.
{%- endcomment -%}

{%- assign cvs_product = product_resource | default: product -%}
{%- assign cvs_api = api_base | default: 'https://charme-customizer.pages.dev' -%}
{%- assign uid = 'cvs-' | append: section.id | append: '-' | append: block.id -%}

<div id="{{ uid }}" class="cvs product-options-step-one" data-charme-variant-selector hidden>
  <div class="cvs__heading" data-cvs-heading>Step 1: Select your phone model and gel</div>

  <div class="cvs__group" data-cvs-colours hidden>
    <div class="cvs__label">Case &amp; Gel Colour <span class="cvs__label-value" data-cvs-colour-label></span></div>
    <div class="cvs__btns" data-cvs-colour-btns></div>
  </div>

  <div class="cvs__group" data-cvs-brands hidden>
    <div class="cvs__label" data-cvs-brand-label>Brand</div>
    <div class="cvs__btns cvs__brand-btns" data-cvs-brand-btns></div>
    <select class="cvs__select cvs__brand-select" data-cvs-brand-select aria-label="Brand"></select>
  </div>

  <div class="cvs__levels" data-cvs-levels></div>

  <div class="cvs__group" data-cvs-models hidden>
    <div class="cvs__label" data-cvs-model-label>Model</div>
    <select class="cvs__select" data-cvs-model></select>
  </div>

  <button type="button" class="cvs__design" data-cvs-design hidden>Design your own</button>
</div>

<style>
  #{{ uid }}{--cvs-accent:#3d3530;--cvs-accent-ink:#f7f0df;--cvs-btn-bg:#f7f0df;--cvs-btn-ink:#3d3530;--cvs-border:#3d3530;box-sizing:border-box;display:flex;flex-direction:column;width:100%;max-width:570px;margin:0 0 -12px;color:var(--color-foreground,#3d3530);font-family:Amiri,serif!important;font-size:14px;font-weight:400;letter-spacing:0;line-height:1.4}
  #{{ uid }}[hidden]{display:none!important}
  #{{ uid }} *{box-sizing:border-box;font-family:Amiri,serif!important;letter-spacing:0}
  #{{ uid }} .cvs__heading{margin:0 0 10px;color:var(--color-foreground,#3d3530);font-family:inherit;font-size:17px;font-weight:600;line-height:1.2}
  #{{ uid }} .cvs__group{margin:0}
  #{{ uid }} [data-cvs-colours]{margin-bottom:16px}
  #{{ uid }} .cvs__label{margin:0 0 8px;color:var(--color-foreground,#3d3530);font-size:14px;font-weight:400;line-height:1.4}
  #{{ uid }} [data-cvs-brands] .cvs__label{margin-bottom:4.8px}
  #{{ uid }} [data-cvs-model-label]{display:none}
  #{{ uid }} .cvs__label-value{margin-left:5px;color:inherit}
  #{{ uid }} .cvs__btns{display:flex;flex-wrap:wrap;gap:10px}
  #{{ uid }} .cvs__btn{min-height:43.994px;padding:10px 22px;border:.625px solid var(--cvs-border);border-radius:999px;background:transparent;color:var(--cvs-btn-ink);font:inherit;font-size:14px;line-height:1.1;cursor:pointer;transition:none}
  #{{ uid }} .cvs__btn:hover{border-color:var(--cvs-accent)}
  #{{ uid }} .cvs__btn:focus-visible,#{{ uid }} .cvs__select:focus-visible,#{{ uid }} .cvs__design:focus-visible{outline:2px solid var(--cvs-accent);outline-offset:2px}
  #{{ uid }} .cvs__btn.is-active{border-color:var(--cvs-accent);background:var(--cvs-accent);color:var(--cvs-accent-ink)}
  #{{ uid }} .cvs__btn.is-out{opacity:.42}
  #{{ uid }} [data-cvs-colour-btns]{gap:11.2px}
  #{{ uid }} [data-cvs-colour-value].is-swatch{position:relative;width:50px;min-width:50px;height:20px;min-height:20px;padding:0;overflow:visible;border:0;border-radius:0;background:var(--cvs-btn-bg);color:transparent;font-size:0;line-height:0}
  #{{ uid }} [data-cvs-colour-value].is-swatch::before{content:'';display:block;width:50px;height:20px;border:.625px solid rgb(61 53 48/.1);border-radius:0;background-color:#d8d5cf;background-image:var(--cvs-swatch-background,none);background-position:var(--cvs-swatch-focal-point,50% 50%);background-repeat:repeat;background-size:50px 20px}
  #{{ uid }} [data-cvs-colour-value*='white'].is-swatch::before{border-color:#ece9e4;background-color:#faf9f7}
  #{{ uid }} [data-cvs-colour-value*='glitter'].is-swatch::before{border-color:rgb(61 53 48/.1);background-color:#efeeeb}
  #{{ uid }} [data-cvs-colour-value*='black'].is-swatch::before{border-color:#494649;background-color:#494649}
  #{{ uid }} [data-cvs-colour-value*='clear'].is-swatch::before{border-color:#dedbd5;background-color:#f4f3f0}
  #{{ uid }} [data-cvs-colour-value*='pink'].is-swatch::before{border-color:#d5aeb6;background-color:#d5aeb6}
  #{{ uid }} [data-cvs-colour-value*='red'].is-swatch::before{border-color:#a53b3e;background-color:#a53b3e}
  #{{ uid }} [data-cvs-colour-value*='blue'].is-swatch::before{border-color:#728da8;background-color:#728da8}
  #{{ uid }} [data-cvs-colour-value*='green'].is-swatch::before{border-color:#728a72;background-color:#728a72}
  #{{ uid }} [data-cvs-colour-value*='gold'].is-swatch::before{border-color:#b99a54;background-color:#b99a54}
  #{{ uid }} [data-cvs-colour-value*='silver'].is-swatch::before{border-color:#aaa9a5;background-color:#c8c7c3}
  #{{ uid }} [data-cvs-colour-value*='purple'].is-swatch::before{border-color:#826f8c;background-color:#826f8c}
  #{{ uid }} [data-cvs-colour-value*='yellow'].is-swatch::before{border-color:#d5bc63;background-color:#d5bc63}
  #{{ uid }} [data-cvs-colour-value].is-swatch.is-active{padding:0;border:0;border-radius:0;background:var(--cvs-btn-bg);color:transparent;outline:1.25px solid var(--cvs-accent);outline-offset:0}
  #{{ uid }} .cvs__select{display:block;width:100%;max-width:none;height:46.435px;min-height:46.435px;margin:8px 0 0;padding:12.8px 25.6px 12.8px 16px;border:.625px solid rgb(0 0 0/.28);border-radius:0;background-color:var(--cvs-btn-bg);color:var(--cvs-btn-ink);font:inherit;font-size:14px;line-height:19.6px!important;cursor:pointer;appearance:auto}
  #{{ uid }} .cvs__brand-select{display:none}
  #{{ uid }}.cvs--dropdowns .cvs__brand-btns{display:none}
  #{{ uid }}.cvs--dropdowns .cvs__brand-select{display:block}
  #{{ uid }} .cvs__levels:empty{display:none}
  #{{ uid }} .cvs__design{width:100%;min-height:46.435px;margin:16px 0 0;padding:12.8px 25.6px;border:.625px solid var(--cvs-accent);border-radius:0;background:var(--cvs-accent);color:var(--cvs-accent-ink);font:inherit;font-size:14px;cursor:pointer}
  .charme-native-option--hidden{display:none!important}
  [data-phone-family-buttons].charme-legacy-family-bridge{display:none!important}
  @media(max-width:749px){#{{ uid }}{max-width:none}}
</style>

<script>
  (function () {
    var root = document.getElementById({{ uid | json }});
    if (!root) return;

    var API = {{ cvs_api | json }};
    var DESIGN_URL = {{ design_url | default: '' | json }};
    var PRODUCT_ID = String({{ cvs_product.id | json }});
    var syncTimer = null;
    var commitTimer = null;
    var unlockTimer = null;
    var pendingNativeInput = null;
    var pendingSelection = null;
    var observer = null;
    var baseTree = [];
    var MODELS = [];
    var COLOURS = [];
    var state = { style: {}, tree: [], path: [], colour: null, model: null };
    var $ = function (selector) { return root.querySelector(selector); };

    function nativePicker() {
      var selector = 'variant-picker[data-product-id="' + PRODUCT_ID + '"]';
      var local = root.parentElement && root.parentElement.querySelector(selector);
      return local || document.querySelector(selector);
    }

    function suppressLegacyFamily() {
      var picker = nativePicker();
      if (!picker) return;
      Array.prototype.forEach.call(picker.querySelectorAll('[data-phone-family-buttons]'), function (buttons) {
        buttons.classList.add('charme-legacy-family-bridge');
      });
      var modelSelect = picker.querySelector('select[name*="Phone Model"]');
      if (modelSelect) {
        Array.prototype.forEach.call(modelSelect.options, function (option) {
          option.hidden = false;
          option.disabled = false;
        });
      }
    }

    suppressLegacyFamily();

    function optionName(block) {
      var label = block && block.querySelector('legend, label');
      return label ? String(label.textContent || '').replace(/\s+/g, ' ').trim() : '';
    }

    function optionBlock(picker, pattern) {
      var blocks = picker ? Array.prototype.slice.call(picker.querySelectorAll('.variant-option')) : [];
      return blocks.filter(function (block) { return pattern.test(optionName(block)); })[0] || null;
    }

    function optionsOf(block) {
      if (!block) return [];
      var select = block.querySelector('select');
      if (select) {
        return Array.prototype.map.call(select.options, function (option) {
          return { value: option.value, out: option.disabled || /\s+-\s+Unavailable$/i.test(option.textContent || '') };
        });
      }
      return Array.prototype.map.call(block.querySelectorAll('input[type="radio"]'), function (input) {
        var swatch = input.parentElement && input.parentElement.querySelector('.swatch');
        return {
          value: input.value,
          out: input.disabled || input.getAttribute('aria-disabled') === 'true' || input.dataset.optionAvailable === 'false',
          swatchBackground: swatch ? swatch.style.getPropertyValue('--swatch-background') : '',
          swatchFocalPoint: swatch ? swatch.style.getPropertyValue('--swatch-focal-point') : '',
        };
      });
    }

    function selectedOf(block) {
      if (!block) return null;
      var select = block.querySelector('select');
      if (select) return select.value || null;
      var checked = block.querySelector('input[type="radio"]:checked');
      return checked ? checked.value : null;
    }

    function nativeData() {
      var picker = nativePicker();
      if (!picker) return null;
      var colourBlock = optionBlock(picker, /case.*gel.*colou?r|gel.*colou?r/i);
      var modelBlock = optionBlock(picker, /phone\s*model/i);
      if (!colourBlock || !modelBlock) return null;
      return {
        picker: picker,
        colourBlock: colourBlock,
        modelBlock: modelBlock,
        colours: optionsOf(colourBlock),
        models: optionsOf(modelBlock),
        colour: selectedOf(colourBlock),
        model: selectedOf(modelBlock),
      };
    }

    function showNative() {
      var picker = nativePicker();
      if (!picker) return;
      Array.prototype.forEach.call(picker.querySelectorAll('.charme-native-option--hidden'), function (block) {
        block.classList.remove('charme-native-option--hidden');
      });
    }

    function hideNative(data) {
      data.colourBlock.classList.add('charme-native-option--hidden');
      data.modelBlock.classList.add('charme-native-option--hidden');
      suppressLegacyFamily();
    }

    function selectedVariant(data) {
      try {
        return JSON.parse(data.picker.querySelector('script[type="application/json"]').textContent || 'null');
      } catch (error) {
        return null;
      }
    }

    function syncVariantInputs(data) {
      var variant = selectedVariant(data);
      if (!variant || !variant.id) return;
      var scope = data.picker.closest('[id^="shopify-section-"]') || data.picker.parentElement;
      Array.prototype.forEach.call(scope.querySelectorAll('form[action*="/cart/add"] [name="id"]'), function (input) {
        input.value = String(variant.id);
      });
    }

    function distinct(values) {
      var seen = {};
      return values.filter(function (item) {
        if (!item.value || seen[item.value]) return false;
        seen[item.value] = true;
        return true;
      });
    }

    function brandOf(model) {
      var value = String(model || '').toLowerCase();
      if (/iphone|ipad/.test(value)) return 'iPhone';
      if (/galaxy|samsung/.test(value)) return 'Samsung';
      if (/pixel/.test(value)) return 'Pixel';
      return 'Other';
    }

    function autoTree(models) {
      var groups = {};
      var order = [];
      models.forEach(function (model) {
        var brand = brandOf(model);
        if (!groups[brand]) { groups[brand] = []; order.push(brand); }
        groups[brand].push(model);
      });
      return order.map(function (brand) {
        return { id: 'auto-' + brand.toLowerCase(), label: brand, children: [], models: groups[brand] };
      });
    }

    function cloneTree(tree) {
      try { return JSON.parse(JSON.stringify(tree || [])); }
      catch (error) { return []; }
    }

    function completeTree(tree) {
      var result = cloneTree(tree);
      if (!result.length) return autoTree(MODELS);
      var assigned = {};
      (function collect(nodes) {
        (nodes || []).forEach(function (node) {
          (node.models || []).forEach(function (model) { if (MODELS.indexOf(model) !== -1) assigned[model] = true; });
          collect(node.children || []);
        });
      })(result);
      autoTree(MODELS.filter(function (model) { return !assigned[model]; })).forEach(function (group) {
        var target = result.filter(function (node) {
          return String(node.label || '').toLowerCase() === group.label.toLowerCase() && !(node.children || []).length;
        })[0];
        if (target) target.models = (target.models || []).concat(group.models);
        else result.push(group);
      });
      return result;
    }

    function collectModels(node) {
      var values = (node.models || []).slice();
      (node.children || []).forEach(function (child) { values = values.concat(collectModels(child)); });
      return values.filter(function (model) { return MODELS.indexOf(model) !== -1; });
    }

    function nodeAtPath(path) {
      var level = state.tree;
      var node = null;
      for (var index = 0; index < path.length; index++) {
        node = (level || []).filter(function (item) { return item.label === path[index]; })[0];
        if (!node) return null;
        level = node.children || [];
      }
      return node;
    }

    function modelsForPath() {
      var node = nodeAtPath(state.path);
      return node ? collectModels(node) : MODELS.slice();
    }

    function pathForModel(nodes, model, prefix) {
      for (var index = 0; index < (nodes || []).length; index++) {
        var node = nodes[index];
        var path = (prefix || []).concat([node.label]);
        if ((node.models || []).indexOf(model) !== -1) return path;
        var nested = pathForModel(node.children || [], model, path);
        if (nested) return nested;
      }
      return null;
    }

    function legacyFamilyFor(model) {
      var value = String(model || '').toLowerCase();
      if (/iphone|ipad/.test(value)) return 'iPhone';
      if (/galaxy|samsung/.test(value)) return 'Samsung';
      if (/pixel/.test(value)) return 'Pixel';
      return 'Other';
    }

    function syncLegacyFamily(block, model) {
      var family = legacyFamilyFor(model);
      var button = Array.prototype.filter.call(block.querySelectorAll('button[data-phone-family]'), function (item) {
        return item.dataset.phoneFamily === family;
      })[0];
      if (button) button.click();
    }

    function setBusy(busy) {
      root.toggleAttribute('aria-busy', busy);
      Array.prototype.forEach.call(root.querySelectorAll('button, select'), function (control) {
        control.disabled = busy;
      });
    }

    function commitNative() {
      var input = pendingNativeInput;
      pendingNativeInput = null;
      if (!input || !input.isConnected) return scheduleSync();
      setBusy(true);
      pendingSelection = { colour: state.colour, model: state.model };
      if (input.tagName === 'SELECT') input.dispatchEvent(new Event('input', { bubbles: true }));
      input.dispatchEvent(new Event('change', { bubbles: true }));
      clearTimeout(unlockTimer);
      unlockTimer = setTimeout(function () {
        pendingSelection = null;
        setBusy(false);
        syncFromNative();
      }, 5000);
      scheduleSync(700);
    }

    function queueNative(input) {
      pendingNativeInput = input;
      clearTimeout(commitTimer);
      commitTimer = setTimeout(commitNative, 180);
    }

    function setNative(block, value) {
      if (!block || !value) return;
      var select = block.querySelector('select');
      if (select) {
        var option = Array.prototype.filter.call(select.options, function (item) { return item.value === value; })[0];
        if (!option) return;
        option.hidden = false;
        option.disabled = false;
        if (select.value === value) return;
        select.value = value;
        option.selected = true;
        if (/phone\s*model/i.test(optionName(block))) syncLegacyFamily(block, value);
        queueNative(select);
      } else {
        var input = Array.prototype.filter.call(block.querySelectorAll('input[type="radio"]'), function (item) {
          return item.value === value;
        })[0];
        if (!input || input.checked) return;
        input.checked = true;
        queueNative(input);
      }
    }

    function applyColour(value) {
      state.colour = value;
      var data = nativeData();
      if (data) setNative(data.colourBlock, value);
      render();
    }

    function applyModel(value) {
      state.model = value;
      state.path = pathForModel(state.tree, value, []) || state.path;
      var data = nativeData();
      if (data) setNative(data.modelBlock, value);
      render();
    }

    function choice(label, active, out, onClick) {
      var button = document.createElement('button');
      button.type = 'button';
      button.className = 'cvs__btn' + (active ? ' is-active' : '') + (out ? ' is-out' : '');
      button.textContent = label;
      if (out) button.setAttribute('aria-disabled', 'true');
      button.addEventListener('click', onClick);
      return button;
    }

    function renderLevels(dropdowns) {
      var levels = $('[data-cvs-levels]');
      levels.innerHTML = '';
      var cursor = state.tree;
      for (var depth = 0; depth < state.path.length; depth++) {
        var node = (cursor || []).filter(function (item) { return item.label === state.path[depth]; })[0];
        var children = node ? (node.children || []) : [];
        if (children.length) {
          var row = document.createElement('div');
          row.className = 'cvs__group';
          var label = document.createElement('div');
          label.className = 'cvs__label';
          label.textContent = node.label;
          row.appendChild(label);
          if (dropdowns) {
            var select = document.createElement('select');
            select.className = 'cvs__select';
            children.forEach(function (child) {
              var option = document.createElement('option');
              option.value = child.label;
              option.textContent = child.label;
              option.selected = state.path[depth + 1] === child.label;
              select.appendChild(option);
            });
            (function (levelDepth) {
              select.addEventListener('change', function (event) {
                state.path = state.path.slice(0, levelDepth + 1).concat([event.target.value]);
                ensureModel();
              });
            })(depth);
            row.appendChild(select);
          } else {
            var buttons = document.createElement('div');
            buttons.className = 'cvs__btns';
            (function (levelDepth) {
              children.forEach(function (child) {
                buttons.appendChild(choice(child.label, state.path[levelDepth + 1] === child.label, false, function () {
                  state.path = state.path.slice(0, levelDepth + 1).concat([child.label]);
                  ensureModel();
                }));
              });
            })(depth);
            row.appendChild(buttons);
          }
          levels.appendChild(row);
        }
        cursor = children;
      }
    }

    function ensureModel() {
      var models = modelsForPath();
      if (models.indexOf(state.model) === -1) applyModel(models[0] || MODELS[0] || null);
      else render();
    }

    function render() {
      var style = state.style || {};
      var dropdowns = style.layout === 'dropdown';
      root.classList.toggle('cvs--dropdowns', dropdowns);
      root.style.setProperty('--cvs-accent', style.accent || '#3d3530');
      root.style.setProperty('--cvs-accent-ink', style.accentInk || '#f7f0df');
      root.style.setProperty('--cvs-btn-bg', style.buttonBg || '#f7f0df');
      root.style.setProperty('--cvs-btn-ink', style.buttonInk || '#3d3530');
      root.style.setProperty('--cvs-border', style.border || '#3d3530');
      $('[data-cvs-heading]').textContent = style.heading || 'Step 1: Select your phone model and gel';
      $('[data-cvs-brand-label]').textContent = style.brandLabel || 'Phone Model';
      $('[data-cvs-model-label]').textContent = style.modelLabel || '';

      var brandButtons = $('[data-cvs-brand-btns]');
      var brandSelect = $('[data-cvs-brand-select]');
      brandButtons.innerHTML = '';
      brandSelect.innerHTML = '';
      state.tree.forEach(function (node) {
        brandButtons.appendChild(choice(node.label, state.path[0] === node.label, false, function () {
          state.path = [node.label];
          ensureModel();
        }));
        var option = document.createElement('option');
        option.value = node.label;
        option.textContent = node.label;
        option.selected = state.path[0] === node.label;
        brandSelect.appendChild(option);
      });
      $('[data-cvs-brands]').hidden = state.tree.length < 2;
      renderLevels(dropdowns);

      var models = modelsForPath();
      var modelSelect = $('[data-cvs-model]');
      modelSelect.innerHTML = '';
      models.forEach(function (model) {
        var option = document.createElement('option');
        option.value = model;
        option.textContent = model;
        option.selected = model === state.model;
        modelSelect.appendChild(option);
      });
      $('[data-cvs-models]').hidden = models.length === 0;

      var colourButtons = $('[data-cvs-colour-btns]');
      colourButtons.innerHTML = '';
      COLOURS.forEach(function (colour) {
        var button = choice(colour.value, colour.value === state.colour, colour.out, function () { applyColour(colour.value); });
        var colourKey = String(colour.value || '').toLowerCase();
        button.setAttribute('data-cvs-colour-value', colourKey);
        button.title = colour.value;
        if (colour.swatchBackground) button.style.setProperty('--cvs-swatch-background', colour.swatchBackground);
        if (colour.swatchFocalPoint) button.style.setProperty('--cvs-swatch-focal-point', colour.swatchFocalPoint);
        if (colour.swatchBackground || /black|white|glitter|clear|pink|red|blue|green|gold|silver|purple|yellow/.test(colourKey)) button.classList.add('is-swatch');
        colourButtons.appendChild(button);
      });
      $('[data-cvs-colour-label]').textContent = state.colour || '';
      $('[data-cvs-colours]').hidden = COLOURS.length === 0;

      var design = $('[data-cvs-design]');
      design.hidden = !DESIGN_URL;
    }

    function syncFromNative() {
      var data = nativeData();
      if (!data || !data.models.length) return false;
      if (pendingSelection) {
        var variant = selectedVariant(data);
        var values = variant && Array.isArray(variant.options) ? variant.options : [];
        var settled = data.colour === pendingSelection.colour
          && data.model === pendingSelection.model
          && values.indexOf(pendingSelection.colour) !== -1
          && values.indexOf(pendingSelection.model) !== -1;
        if (!settled) {
          hideNative(data);
          root.hidden = false;
          scheduleSync(120);
          return true;
        }
        pendingSelection = null;
      }
      MODELS = distinct(data.models).map(function (item) { return item.value; });
      COLOURS = distinct(data.colours);
      state.tree = completeTree(baseTree);
      state.model = MODELS.indexOf(data.model) !== -1 ? data.model : (state.model || MODELS[0] || null);
      state.colour = COLOURS.some(function (item) { return item.value === data.colour; }) ? data.colour : (state.colour || (COLOURS[0] && COLOURS[0].value));
      state.path = pathForModel(state.tree, state.model, []) || (state.tree[0] ? [state.tree[0].label] : []);
      hideNative(data);
      syncVariantInputs(data);
      root.hidden = false;
      render();
      clearTimeout(unlockTimer);
      setBusy(false);
      return true;
    }

    function scheduleSync(delay) {
      clearTimeout(syncTimer);
      syncTimer = setTimeout(syncFromNative, delay == null ? 80 : delay);
    }

    function start(config) {
      var selector = config || {};
      if (selector.enabled === false) {
        root.hidden = true;
        showNative();
        return;
      }
      state.style = selector.style || {};
      baseTree = selector.tree || [];
      var attempts = 0;
      (function waitForPicker() {
        if (syncFromNative()) {
          var host = root.parentElement || document.body;
          observer = new MutationObserver(function (mutations) {
            var needsSync = mutations.some(function (mutation) {
              var target = mutation.target;
              if (root.contains(target)) return false;
              if (mutation.type === 'childList') return true;
              if (target.matches && target.matches('.variant-option')) {
                return !target.classList.contains('charme-native-option--hidden');
              }
              if (target.matches && target.matches('[data-phone-family-buttons]')) {
                return !target.classList.contains('charme-legacy-family-bridge');
              }
              return false;
            });
            if (needsSync) scheduleSync();
          });
          observer.observe(host, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['class'],
          });
          return;
        }
        attempts += 1;
        if (attempts < 40) setTimeout(waitForPicker, 50);
      })();
    }

    $('[data-cvs-brand-select]').addEventListener('change', function (event) {
      state.path = [event.target.value];
      ensureModel();
    });
    $('[data-cvs-model]').addEventListener('change', function (event) { applyModel(event.target.value); });
    $('[data-cvs-design]').addEventListener('click', function () {
      if (!DESIGN_URL) return;
      if (DESIGN_URL.charAt(0) === '#') {
        var target = document.querySelector(DESIGN_URL);
        if (target) target.scrollIntoView({ behavior: 'smooth' });
      } else {
        location.href = DESIGN_URL;
      }
    });

    fetch(API + '/api/settings', { headers: { accept: 'application/json' }, cache: 'no-store' })
      .then(function (response) { return response.ok ? response.json() : {}; })
      .then(function (settings) { start(settings && settings.variantSelector); })
      .catch(function () { start({ enabled: true, style: {}, tree: [] }); });
  })();
</script>