{%- comment -%}
  charme-variant-selector.liquid — hierarchical BRAND → MODEL variant picker for
  the "Custom phone case" product page (replaces the theme's native model/colour
  <select>s with the Charmé-styled selector).

  Install: on the product template, add a Custom Liquid block with:
      {% render 'charme-variant-selector' %}
  and hide the theme's native variant picker for this product.

  Optional params:
      {% render 'charme-variant-selector',
         api_base: 'https://charme-customizer.pages.dev',
         design_url: '' %}   {%- comment -%} link/anchor for "Design your own" {%- endcomment -%}

  Look & feel + the brand/sub-brand hierarchy are controlled from the app admin
  (Admin → Products → Variant selector); this snippet fetches them at runtime from
  {api_base}/api/settings (variantSelector.style + variantSelector.tree). When the
  tree is empty it auto-groups models by brand (Apple / Samsung / Google / Other).
{%- endcomment -%}

{%- assign cvs_api = api_base | default: 'https://charme-customizer.pages.dev' -%}
{%- assign uid = 'cvs-' | append: product.id -%}

<div id="{{ uid }}" class="cvs" data-charme-variant-selector>
  <div class="cvs__head">
    <div class="cvs__title">{{ product.title }}</div>
    <div class="cvs__price" data-cvs-price>{{ product.selected_or_first_available_variant.price | money }}</div>
  </div>
  <div class="cvs__heading" data-cvs-heading>1. Select your case</div>

  <div class="cvs__group" data-cvs-brands hidden>
    <div class="cvs__label" data-cvs-brand-label>Brand</div>
    <div class="cvs__btns" data-cvs-brand-btns></div>
  </div>

  {%- comment -%} One row per extra hierarchy level (sub-brand, sub-sub-brand…) {%- endcomment -%}
  <div class="cvs__levels" data-cvs-levels></div>

  <div class="cvs__group" data-cvs-models hidden>
    <div class="cvs__label" data-cvs-model-label>Model</div>
    <select class="cvs__select" data-cvs-model></select>
  </div>

  <div class="cvs__group" data-cvs-colours hidden>
    <div class="cvs__label">Case &amp; Gel Colour <span class="cvs__label-value" data-cvs-colour-label></span></div>
    <div class="cvs__btns" data-cvs-colour-btns></div>
  </div>

  <button type="button" class="cvs__design" data-cvs-design hidden>Design your own</button>
</div>

<style>
  #{{ uid }}{--cvs-accent:#34312e;--cvs-accent-ink:#fff;--cvs-btn-bg:#fff;--cvs-btn-ink:#34312e;--cvs-border:#aaa69f;--cvs-radius:0px;box-sizing:border-box;display:flex;flex-direction:column;width:100%;max-width:570px;margin-top:26px;padding-top:34px;border-top:1px solid #cfcbc4;color:#34312e;font-family:inherit;letter-spacing:0}
  #{{ uid }} *{box-sizing:border-box;letter-spacing:0}
  #{{ uid }} .cvs__head,#{{ uid }} .cvs__heading{display:none}
  #{{ uid }} [data-cvs-colours]{order:1}
  #{{ uid }} [data-cvs-brands]{order:2}
  #{{ uid }} .cvs__levels{order:3}
  #{{ uid }} [data-cvs-models]{order:4}
  #{{ uid }} .cvs__design{order:5}
  #{{ uid }} .cvs__group{margin:0 0 22px}
  #{{ uid }} .cvs__label{margin:0 0 9px;color:#383430;font-size:17px;font-weight:400;line-height:1.35}
  #{{ uid }} .cvs__label-value{margin-left:5px;color:#4b4742}
  #{{ uid }} .cvs__btns{display:flex;flex-wrap:wrap;gap:9px}
  #{{ uid }} .cvs__btn{min-height:44px;padding:9px 18px;border:1px solid var(--cvs-border);border-radius:0;background:var(--cvs-btn-bg);color:var(--cvs-btn-ink);font:inherit;font-size:16px;line-height:1.2;cursor:pointer;transition:border-color .12s ease,background-color .12s ease,color .12s ease}
  #{{ uid }} .cvs__btn:hover{border-color:var(--cvs-accent)}
  #{{ uid }} .cvs__btn:focus-visible,#{{ uid }} .cvs__select:focus-visible,#{{ uid }} .cvs__design:focus-visible{outline:2px solid var(--cvs-accent);outline-offset:2px}
  #{{ uid }} .cvs__btn.is-active{border-color:var(--cvs-accent);background:var(--cvs-accent);color:var(--cvs-accent-ink)}
  #{{ uid }} .cvs__btn.is-out{opacity:.42}
  #{{ uid }} [data-cvs-colour-btns]{gap:10px}
  #{{ uid }} [data-cvs-colour-value].is-swatch{position:relative;width:76px;min-width:76px;height:40px;min-height:40px;padding:4px;overflow:hidden;border-color:#ddd9d3;background:#fff;color:transparent;font-size:0}
  #{{ uid }} [data-cvs-colour-value].is-swatch::before{content:'';display:block;width:100%;height:100%;border:1px solid #e2dfda;background:#d8d5cf}
  #{{ uid }} [data-cvs-colour-value*='white'].is-swatch::before{border-color:#ece9e4;background:#faf9f7}
  #{{ uid }} [data-cvs-colour-value*='glitter'].is-swatch::before{border-color:#dedbd5;background-color:#efeeeb;background-image:radial-gradient(circle at 18% 32%,rgba(255,255,255,.95) 0 1px,transparent 1.5px),radial-gradient(circle at 72% 66%,rgba(190,187,181,.6) 0 1px,transparent 1.5px),radial-gradient(circle at 48% 20%,rgba(255,255,255,.9) 0 1px,transparent 1.5px)}
  #{{ uid }} [data-cvs-colour-value*='black'].is-swatch::before{border-color:#494649;background:#494649}
  #{{ uid }} [data-cvs-colour-value*='clear'].is-swatch::before{border-color:#dedbd5;background:#f4f3f0}
  #{{ uid }} [data-cvs-colour-value*='pink'].is-swatch::before{border-color:#d5aeb6;background:#d5aeb6}
  #{{ uid }} [data-cvs-colour-value*='red'].is-swatch::before{border-color:#a53b3e;background:#a53b3e}
  #{{ uid }} [data-cvs-colour-value*='blue'].is-swatch::before{border-color:#728da8;background:#728da8}
  #{{ uid }} [data-cvs-colour-value*='green'].is-swatch::before{border-color:#728a72;background:#728a72}
  #{{ uid }} [data-cvs-colour-value*='gold'].is-swatch::before{border-color:#b99a54;background:#b99a54}
  #{{ uid }} [data-cvs-colour-value*='silver'].is-swatch::before{border-color:#aaa9a5;background:#c8c7c3}
  #{{ uid }} [data-cvs-colour-value*='purple'].is-swatch::before{border-color:#826f8c;background:#826f8c}
  #{{ uid }} [data-cvs-colour-value*='yellow'].is-swatch::before{border-color:#d5bc63;background:#d5bc63}
  #{{ uid }} [data-cvs-colour-value].is-swatch.is-active{padding:3px;border:2px solid var(--cvs-accent);background:#fff;color:transparent}
  #{{ uid }} .cvs__select{display:block;width:100%;max-width:none;min-height:66px;margin:0;padding:0 52px 0 23px;border:1px solid var(--cvs-border);border-radius:0;background-color:#fff;background-image:linear-gradient(45deg,transparent 50%,#625e59 50%),linear-gradient(135deg,#625e59 50%,transparent 50%);background-position:calc(100% - 22px) 50%,calc(100% - 17px) 50%;background-repeat:no-repeat;background-size:5px 5px;color:#34312e;font:inherit;font-size:17px;line-height:1.3;cursor:pointer;appearance:none;-webkit-appearance:none}
  #{{ uid }} .cvs__design{width:100%;min-height:62px;margin:2px 0 0;padding:13px 24px;border:1px solid #56524d;border-radius:0;background:#cbd7e5;color:#34312e;font:inherit;font-size:17px;cursor:pointer}
  #{{ uid }} .cvs__levels:empty{display:none}
  #{{ uid }} [data-cvs-brands]:has(.cvs__btn:only-child),#{{ uid }} .cvs__levels .cvs__group:has(.cvs__btn:only-child){display:none}
  @media(max-width:749px){#{{ uid }}{max-width:none;margin-top:22px;padding-top:28px}#{{ uid }} .cvs__group{margin-bottom:20px}#{{ uid }} .cvs__label{font-size:16px}#{{ uid }} .cvs__btn{min-height:42px;padding:8px 15px;font-size:15px}#{{ uid }} [data-cvs-colour-value].is-swatch{width:68px;min-width:68px;height:38px;min-height:38px}#{{ uid }} .cvs__select{min-height:60px;padding-left:18px;font-size:16px}#{{ uid }} .cvs__design{min-height:58px;font-size:16px}}
</style>

<script>
  (function () {
    var root = document.getElementById({{ uid | json }});
    if (!root) return;
    var API = {{ cvs_api | json }};
    var DESIGN_URL = {{ design_url | default: '' | json }};

    // Variants inlined from Liquid (option1 = colour, option2 = model).
    var VARIANTS = [
      {%- for v in product.variants -%}
      { id: {{ v.id | json }}, colour: {{ v.option1 | json }}, model: {{ v.option2 | json }},
        available: {{ v.available | json }}, price: {{ v.price | json }},
        image: {{ v.featured_image | default: product.featured_image | image_url: width: 400 | json }} }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ];

    var $ = function (sel) { return root.querySelector(sel); };
    var money = function (cents) {
      try { return new Intl.NumberFormat(undefined, { style: 'currency', currency: {{ shop.currency | json }} }).format((cents || 0) / 100); }
      catch (e) { return '£' + ((cents || 0) / 100).toFixed(2); }
    };

    // Distinct option values, in first-seen order.
    function distinct(key) { var seen = {}, out = []; VARIANTS.forEach(function (v) { if (v[key] && !seen[v[key]]) { seen[v[key]] = 1; out.push(v[key]); } }); return out; }
    var COLOURS = distinct('colour');
    var MODELS = distinct('model');

    // Auto brand grouping used when the admin hasn't defined a tree.
    function brandOf(model) {
      var m = String(model || '').toLowerCase();
      if (/iphone|ipad/.test(m)) return 'Apple';
      if (/galaxy|samsung/.test(m)) return 'Samsung';
      if (/pixel/.test(m)) return 'Google';
      if (/huawei|xiaomi|oneplus|oppo|android|other phone/.test(m)) return 'Android';
      return 'Other';
    }
    function autoTree() {
      var groups = {}, order = [];
      MODELS.forEach(function (m) { var b = brandOf(m); if (!groups[b]) { groups[b] = []; order.push(b); } groups[b].push(m); });
      return order.map(function (b) { return { label: b, children: [], models: groups[b] }; });
    }

    var state = { style: {}, tree: [], path: [], colour: COLOURS[0] || null, model: null };

    // ---- resolve the selected variant + push it into the theme's form -------
    function variantFor(colour, model) {
      return VARIANTS.filter(function (v) { return v.model === model && v.colour === colour; })[0] ||
             VARIANTS.filter(function (v) { return v.model === model; })[0] || null;
    }
    function applyVariant() {
      var v = variantFor(state.colour, state.model);
      if (!v) return;
      var form = document.querySelector('form[action*="/cart/add"]');
      var input = form && (form.querySelector('[name="id"]') );
      if (form && !input) { input = document.createElement('input'); input.type = 'hidden'; input.name = 'id'; form.appendChild(input); }
      if (input) { input.value = v.id; input.dispatchEvent(new Event('change', { bubbles: true })); }
      try { var u = new URL(location.href); u.searchParams.set('variant', v.id); history.replaceState({}, '', u); } catch (e) {}
      var priceEl = $('[data-cvs-price]'); if (priceEl) priceEl.textContent = money(v.price);
    }

    // ---- rendering ----------------------------------------------------------
    function nodesAtPath() {
      var level = state.tree, node = null;
      for (var i = 0; i < state.path.length; i++) { node = (level || []).filter(function (n) { return n.label === state.path[i]; })[0]; level = node ? (node.children || []) : []; }
      return { siblings: state.path.length ? (parentChildren()) : state.tree, node: node };
    }
    function parentChildren() {
      var level = state.tree, node = null;
      for (var i = 0; i < state.path.length; i++) { node = (level || []).filter(function (n) { return n.label === state.path[i]; })[0]; if (i < state.path.length - 1) level = node ? (node.children || []) : []; }
      return level;
    }
    // Models available for the current path (leaf models, or all under the branch).
    function modelsForPath() {
      var level = state.tree, node = null;
      for (var i = 0; i < state.path.length; i++) { node = (level || []).filter(function (n) { return n.label === state.path[i]; })[0]; level = node ? (node.children || []) : []; }
      function collect(n) { var out = (n.models || []).slice(); (n.children || []).forEach(function (c) { out = out.concat(collect(c)); }); return out; }
      if (!node) return [];
      var all = collect(node);
      // keep only models that actually exist as variants
      return all.filter(function (m) { return MODELS.indexOf(m) !== -1; });
    }

    function btn(label, active, out, onClick) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'cvs__btn' + (active ? ' is-active' : '') + (out ? ' is-out' : '');
      b.textContent = label;
      b.addEventListener('click', onClick);
      return b;
    }

    function render() {
      var st = state.style || {};
      root.style.setProperty('--cvs-accent', st.accent || '#34312e');
      root.style.setProperty('--cvs-accent-ink', st.accentInk || '#fff');
      root.style.setProperty('--cvs-btn-bg', st.buttonBg || '#fff');
      root.style.setProperty('--cvs-btn-ink', st.buttonInk || '#34312e');
      root.style.setProperty('--cvs-border', st.border || '#aaa69f');
      root.style.setProperty('--cvs-radius', (st.radius != null ? st.radius : 0) + 'px');
      $('[data-cvs-heading]').textContent = st.heading || '1. Select your case';
      $('[data-cvs-brand-label]').textContent = st.brandLabel || 'Brand';
      $('[data-cvs-model-label]').textContent = st.modelLabel || 'Model';
      $('[data-cvs-price]').style.display = st.showPrice === false ? 'none' : '';

      // Top-level brands.
      var brands = $('[data-cvs-brand-btns]');
      brands.innerHTML = '';
      (state.tree || []).forEach(function (n) {
        brands.appendChild(btn(n.label, state.path[0] === n.label, false, function () {
          state.path = [n.label]; ensureModel(); render();
        }));
      });
      $('[data-cvs-brands]').hidden = !(state.tree && state.tree.length);

      // Intermediate levels (children of the chosen node, recursively).
      var levels = $('[data-cvs-levels]');
      levels.innerHTML = '';
      var cursor = state.tree, depth = 0;
      while (depth < state.path.length) {
        var node = (cursor || []).filter(function (n) { return n.label === state.path[depth]; })[0];
        var kids = node ? (node.children || []) : [];
        if (kids.length) {
          var row = document.createElement('div');
          row.className = 'cvs__group';
          var lbl = document.createElement('div'); lbl.className = 'cvs__label'; lbl.textContent = node.label; row.appendChild(lbl);
          var wrap = document.createElement('div'); wrap.className = 'cvs__btns';
          (function (dpth) {
            kids.forEach(function (k) {
              wrap.appendChild(btn(k.label, state.path[dpth + 1] === k.label, false, function () {
                state.path = state.path.slice(0, dpth + 1).concat([k.label]); ensureModel(); render();
              }));
            });
          })(depth);
          row.appendChild(wrap); levels.appendChild(row);
        }
        cursor = kids; depth++;
      }

      // Model dropdown for the current branch.
      var models = state.path.length ? modelsForPath() : MODELS;
      var sel = $('[data-cvs-model]');
      sel.innerHTML = '';
      models.forEach(function (m) {
        var o = document.createElement('option'); o.value = m; o.textContent = m; if (m === state.model) o.selected = true; sel.appendChild(o);
      });
      $('[data-cvs-models]').hidden = models.length === 0;

      // Colours.
      var cwrap = $('[data-cvs-colour-btns]');
      cwrap.innerHTML = '';
      COLOURS.forEach(function (c) {
        var v = variantFor(c, state.model);
        var colourButton = btn(c, state.colour === c, v && !v.available, function () { state.colour = c; applyVariant(); render(); });
        var colourKey = String(c || '').toLowerCase();
        colourButton.setAttribute('data-cvs-colour-value', colourKey);
        colourButton.title = c;
        if (/black|white|glitter|clear|pink|red|blue|green|gold|silver|purple|yellow/.test(colourKey)) colourButton.classList.add('is-swatch');
        cwrap.appendChild(colourButton);
      });
      $('[data-cvs-colour-label]').textContent = state.colour || '';
      $('[data-cvs-colours]').hidden = COLOURS.length === 0;

      if (DESIGN_URL) { var d = $('[data-cvs-design]'); d.hidden = false; }
    }

    function ensureModel() {
      var models = state.path.length ? modelsForPath() : MODELS;
      if (models.indexOf(state.model) === -1) state.model = models[0] || MODELS[0] || null;
      applyVariant();
    }

    $('[data-cvs-model]').addEventListener('change', function (e) { state.model = e.target.value; applyVariant(); render(); });
    var design = $('[data-cvs-design]');
    if (design) design.addEventListener('click', function () { if (DESIGN_URL) { if (DESIGN_URL.charAt(0) === '#') { var t = document.querySelector(DESIGN_URL); if (t) t.scrollIntoView({ behavior: 'smooth' }); } else location.href = DESIGN_URL; } });

    // Preselect from the current URL / form, else first values.
    (function preselect() {
      var vid = new URLSearchParams(location.search).get('variant');
      var cur = vid && VARIANTS.filter(function (v) { return String(v.id) === String(vid); })[0];
      if (cur) { state.colour = cur.colour; state.model = cur.model; }
      else { state.model = MODELS[0] || null; }
    })();

    // Load admin style + hierarchy, then render.
    fetch(API + '/api/settings', { headers: { accept: 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : {}; })
      .then(function (s) {
        var vs = (s && s.variantSelector) || {};
        state.style = vs.style || {};
        state.tree = (vs.tree && vs.tree.length) ? vs.tree : autoTree();
        // set the initial path to the brand that contains the preselected model
        if (state.model) {
          for (var i = 0; i < state.tree.length; i++) {
            var flat = []; (function walk(n) { (n.models || []).forEach(function (m) { flat.push(m); }); (n.children || []).forEach(walk); })(state.tree[i]);
            if (flat.indexOf(state.model) !== -1) { state.path = [state.tree[i].label]; break; }
          }
        }
        render();
        applyVariant();
      })
      .catch(function () { state.tree = autoTree(); render(); applyVariant(); });
  })();
</script>
