{% comment %}
  Charmé cart styling + orphan cleanup — Horizon-style themes.
  ---------------------------------------------------------------------------
  A custom design is added as several cart lines (base case + one line per charm)
  sharing a `_design_token` property; charm lines carry `_role: 'charm'`. The
  visual folding into a single "Custom Charm Case" row is done SERVER-SIDE in
  snippets/charme-cart-line.liquid (rendered from cart-products.liquid), so it
  works in the cart page AND the drawer with no JS/timing issues.

  This snippet only provides:
    1. The shared CSS for the folded row (breakdown list, edit button, contained
       proof preview image).
    2. Orphan cleanup — if the base case line is removed, its (never-shown) charm
       lines are deleted so they don't linger through to checkout.

  ⚠️ Cosmetic, cart-only — the CHECKOUT page still shows the separate lines
  (that needs Checkout Extensibility + a Cart Transform function).

  INSTALL: paste `{% render 'charme-cart-group' %}` once near the end of
  layout/theme.liquid (just before </body>).
{% endcomment %}

<style>
  .charme-bundle-detail{list-style:none;margin:8px 0 0;padding:8px 10px;background:rgb(var(--color-foreground-rgb)/0.05);border-radius:8px;font-size:.85em;line-height:1.6}
  .charme-bundle-detail li{display:flex;justify-content:space-between;gap:10px}
  .charme-bundle-detail li.charme-bundle-total{font-weight:600;border-top:1px solid rgb(var(--color-foreground-rgb)/0.15);margin-top:4px;padding-top:4px}
  .charme-row-hidden{display:none !important}
  .charme-edit-btn{display:inline-block;margin-top:8px;padding:5px 12px;border:1px solid currentColor;border-radius:6px;font-size:.82em;text-decoration:none;color:inherit;cursor:pointer}
  .charme-edit-btn:hover{opacity:.7}
  /* Keep the design preview (a tall phone-case shot) within the thumbnail cell */
  .cart-items__media-container.charme-proof-container{aspect-ratio:auto !important}
  .charme-proof-img{width:100% !important;height:auto !important;max-height:120px !important;object-fit:contain !important;aspect-ratio:auto !important}
</style>

<script>
(function () {

  var latestCart = null;
  var refreshTimer;

  function base64UrlEncode(value) {
    var bytes = new TextEncoder().encode(value);
    var binary = '';
    for (var i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
    return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }

  function hydrateEditLinks(cart) {
    var layouts = {};
    (cart.items || []).forEach(function (item) {
      var properties = item.properties || {};
      var token = properties._design_token;
      var layout = properties._layout;
      if (!token || properties._role === 'charm' || typeof layout !== 'string' || !layout || layout.length > 120000) return;
      try { JSON.parse(layout); } catch (error) { return; }
      layouts[token] = layout;
    });
    document.querySelectorAll('[data-charme-edit-token][data-charme-edit-url]').forEach(function (link) {
      var token = link.getAttribute('data-charme-edit-token') || '';
      var layout = layouts[token];
      if (!/^[A-Za-z0-9_-]{1,128}$/.test(token) || !layout) return;
      try {
        var url = new URL(link.getAttribute('data-charme-edit-url'), window.location.origin);
        var hash = new URLSearchParams();
        hash.set('charme_layout', base64UrlEncode(layout));
        hash.set('charme_edit_token', token);
        url.hash = hash.toString();
        link.href = url.toString();
        link.setAttribute('data-charme-edit-ready', '1');
      } catch (error) {}
    });
  }

  function decodeBridgePayload(encoded) {
    if (!encoded || encoded.length > 200000) throw new Error('Invalid cart payload');
    var base64 = encoded.replace(/-/g, '+').replace(/_/g, '/');
    while (base64.length % 4) base64 += '=';
    var binary = atob(base64);
    var bytes = new Uint8Array(binary.length);
    for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    return JSON.parse(new TextDecoder().decode(bytes));
  }

  function bridgeItems(payload) {
    if (!payload || payload.version !== 1 || !Array.isArray(payload.items) || payload.items.length > 100) {
      throw new Error('Invalid cart payload');
    }
    return payload.items.map(function (raw) {
      var id = Number(raw && raw.id);
      var quantity = Number(raw && raw.quantity) || 1;
      if (!Number.isSafeInteger(id) || id <= 0 || !Number.isSafeInteger(quantity) || quantity <= 0) {
        throw new Error('Invalid cart item');
      }
      var properties = {};
      Object.keys((raw && raw.properties) || {}).forEach(function (key) {
        var value = raw.properties[key];
        if (typeof key !== 'string' || key.length > 255 || value == null || String(value).length > 120000) {
          throw new Error('Invalid cart properties');
        }
        properties[key] = String(value);
      });
      return { id: id, quantity: quantity, properties: properties };
    });
  }

  async function applyCartBridge() {
    var params = new URLSearchParams(location.hash.replace(/^#/, ''));
    var encoded = params.get('charme-cart');
    if (!encoded) return false;
    if (window.__charmeAdding) return true;
    window.__charmeAdding = true;
    try {
      var payload = decodeBridgePayload(encoded);
      var items = bridgeItems(payload);
      var cart = await fetch('/cart.js', { headers: { Accept: 'application/json' } }).then(function (r) {
        if (!r.ok) throw new Error('Could not read cart');
        return r.json();
      });
      var existingTokens = {};
      (cart.items || []).forEach(function (item) {
        var token = item.properties && item.properties._design_token;
        if (token) existingTokens[token] = true;
      });
      var missing = items.filter(function (item) {
        var token = item.properties && item.properties._design_token;
        return !token || !existingTokens[token];
      });
      if (missing.length) {
        var addResponse = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: missing }),
        });
        if (!addResponse.ok) throw new Error('Could not add design to cart');
      }

      var replaceToken = String(payload.replaceDesignToken || '');
      var incomingTokens = {};
      items.forEach(function (item) {
        var token = item.properties && item.properties._design_token;
        if (token) incomingTokens[token] = true;
      });
      if (/^[A-Za-z0-9_-]{1,128}$/.test(replaceToken) && !incomingTokens[replaceToken]) {
        var refreshed = await fetch('/cart.js', { headers: { Accept: 'application/json' } }).then(function (r) {
          if (!r.ok) throw new Error('Could not verify cart');
          return r.json();
        });
        var updates = {};
        (refreshed.items || []).forEach(function (item) {
          if (item.properties && item.properties._design_token === replaceToken) updates[item.key] = 0;
        });
        if (Object.keys(updates).length) {
          var updateResponse = await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ updates: updates }),
          });
          if (!updateResponse.ok) throw new Error('Could not replace old design');
        }
      }

      history.replaceState(null, '', location.pathname + location.search);
      window.location.reload();
    } catch (error) {
      window.__charmeAdding = false;
      console.error('[Charmé] cart bridge failed', error);
      window.alert('We could not update your cart. Please refresh this page to try again.');
    }
    return true;
  }

  // If a base case line is removed, its charm lines are orphaned — remove them
  // too so the cart stays consistent (charm rows are hidden and can't be removed
  // on their own). Detects any _design_token group that has charms but no base.
  async function cleanupOrphans(cart) {
    if (window.__charmeCleaning) return;
    if (!cart || !cart.items) return;
    var byTok = {};
    cart.items.forEach(function (it) {
      var t = it.properties && it.properties._design_token;
      if (!t) return;
      (byTok[t] = byTok[t] || []).push(it);
    });
    var updates = {};
    Object.keys(byTok).forEach(function (t) {
      var g = byTok[t];
      var hasBase = g.some(function (it) { return !(it.properties && it.properties._role === 'charm'); });
      if (!hasBase) g.forEach(function (it) { updates[it.key] = 0; });
    });
    if (Object.keys(updates).length) {
      window.__charmeCleaning = true;
      try {
        await fetch('/cart/update.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ updates: updates }) });
      } catch (e) {}
      window.location.reload();
    }
  }

  async function applyAll() {
    if (await applyCartBridge()) return;
    var cart;
    try { cart = await fetch('/cart.js', { headers: { Accept: 'application/json' }, cache: 'no-store' }).then(function (r) {
      if (!r.ok) throw new Error('Could not read cart');
      return r.json();
    }); }
    catch (e) { return; }
    latestCart = cart;
    hydrateEditLinks(cart);
    // Visual folding is now done SERVER-SIDE (snippets/charme-cart-line.liquid),
    // so it works in the cart page AND the drawer with no timing issues. Here we
    // only clean up orphaned charm lines when the base case is removed.
    cleanupOrphans(cart);
  }

  function boot() {
    applyAll();
    var t;
    var reapply = function () {
      clearTimeout(t);
      t = setTimeout(function () {
        if (latestCart) hydrateEditLinks(latestCart);
      }, 120);
    };
    var refresh = function () {
      clearTimeout(refreshTimer);
      refreshTimer = setTimeout(applyAll, 250);
    };

    // Re-check for orphaned charm lines whenever the cart re-renders in the cart
    // page or the drawer (the drawer is re-rendered wholesale on add-to-cart — a
    // childList change under <body>). Debounced; cleanup is a no-op unless a base
    // case was removed.
    new MutationObserver(reapply).observe(document.body, { childList: true, subtree: true });

    // The cart drawer is a <dialog> inside <cart-drawer-component>; also re-check
    // when the user opens it.
    document.addEventListener('click', function (e) {
      var t2 = e.target;
      if (t2 && t2.closest && t2.closest('[data-testid="cart-drawer-trigger"], cart-drawer-component, .cart-drawer, a[href$="/cart"]')) reapply();
      if (t2 && t2.closest && t2.closest('.cart-items__remove')) refresh();
    }, true);

    ['cart:refresh', 'cart:updated', 'cart:change', 'cart:add', 'on:cart:update'].forEach(function (ev) {
      document.addEventListener(ev, refresh);
    });

    // A couple of delayed passes for late-hydrating drawers.
    [400, 1200].forEach(function (d) {
      setTimeout(function () {
        if (latestCart) hydrateEditLinks(latestCart);
        else applyAll();
      }, d);
    });
  }
  if (document.readyState !== 'loading') boot();
  else document.addEventListener('DOMContentLoaded', boot);
})();
</script>
