{% comment %}
  Charmé cart grouping (NO Checkout Extensibility needed) — Horizon-style themes.
  ---------------------------------------------------------------------------
  Cart mode adds a custom case as several cart lines (base case + one line per
  charm) sharing a `_design_token` property. This visually folds each group —
  in BOTH the cart drawer and the cart page (`<cart-items-component>`) — into a
  single "Custom Charm Case" row with the charms listed underneath and a
  combined price. Matches rows by their `data-key` (line item key), so it's
  robust, and re-applies on AJAX cart updates.

  ⚠️ Cosmetic, cart-only — the CHECKOUT page still shows the separate lines
  (that needs Checkout Extensibility + a Cart Transform function).

  INSTALL: paste `{% render 'charme-cart-group' %}` once near the end of
  layout/theme.liquid (just before </body>). One place covers drawer + cart page.
{% endcomment %}

<style>
  .charme-bundle-detail{list-style:none;margin:8px 0 0;padding:8px 10px;background:rgb(var(--color-foreground-rgb)/0.05);border-radius:8px;font-size:.85em;line-height:1.6}
  .charme-bundle-detail li{display:flex;justify-content:space-between;gap:10px}
  .charme-bundle-detail li.charme-bundle-total{font-weight:600;border-top:1px solid rgb(var(--color-foreground-rgb)/0.15);margin-top:4px;padding-top:4px}
  .charme-row-hidden{display:none !important}
  .charme-edit-btn{display:inline-block;margin-top:8px;padding:5px 12px;border:1px solid currentColor;border-radius:6px;font-size:.82em;text-decoration:none;color:inherit;cursor:pointer}
  .charme-edit-btn:hover{opacity:.7}
</style>

<script>
(function () {
  var CASE_TITLE = 'Custom Charm Case';

  function money(c) {
    try { return (window.Shopify && Shopify.formatMoney) ? Shopify.formatMoney(c) : '\u00a3' + (c / 100).toFixed(2); }
    catch (e) { return '\u00a3' + (c / 100).toFixed(2); }
  }
  function esc(k) { return (window.CSS && CSS.escape) ? CSS.escape(k) : String(k).replace(/"/g, '\\"'); }
  function rowByKey(root, key) { return root.querySelector('.cart-items__table-row[data-key="' + esc(key) + '"]'); }

  async function applyIn(root) {
    var cart;
    try { cart = await fetch('/cart.js', { headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); }); }
    catch (e) { return; }
    if (!cart || !cart.items || !cart.items.length) return;

    var groups = {};
    cart.items.forEach(function (it) {
      var tok = it.properties && it.properties._design_token;
      if (!tok) return;
      (groups[tok] = groups[tok] || []).push(it);
    });

    Object.keys(groups).forEach(function (tok) {
      var g = groups[tok];
      if (g.length < 2) return;
      var base = g.filter(function (it) { return !(it.properties && it.properties._role === 'charm'); })[0] || g[0];
      var charms = g.filter(function (it) { return it !== base; });
      var baseRow = rowByKey(root, base.key);
      if (!baseRow || baseRow.getAttribute('data-charme-grouped')) return;

      // Hide the charm rows.
      charms.forEach(function (it) { var r = rowByKey(root, it.key); if (r) r.classList.add('charme-row-hidden'); });

      // Rename the base row's title.
      var titleEl = baseRow.querySelector('.cart-items__title');
      if (titleEl) titleEl.textContent = CASE_TITLE;

      // Show the design preview (proof) as the case image, if it was uploaded.
      var proof = base.properties && (base.properties.Proof || base.properties._proof);
      if (proof) {
        var img = baseRow.querySelector('.cart-items__media-image, .cart-items__media img');
        if (img) { img.removeAttribute('srcset'); img.src = proof; }
      }

      // A custom case is a single design — hide the qty stepper (keep the
      // remove button); removing the case cleans up its charms (see below).
      var qtyEl = baseRow.querySelector('.cart-items__quantity quantity-selector, .cart-items__quantity .quantity-selector');
      if (qtyEl) qtyEl.style.display = 'none';

      // Hide the raw line-item properties (Proof url, Design, Finish) on the
      // base row — we render a clean detail list instead. They still ride on
      // the ORDER so you can see the proof in Shopify Admin.
      baseRow.querySelectorAll('.cart-items__properties').forEach(function (el) { el.style.display = 'none'; });

      // Combined price on the base row.
      var total = g.reduce(function (s, it) { return s + it.final_line_price; }, 0);
      var tc = baseRow.querySelector('.cart-items__price text-component');
      if (tc) { tc.textContent = money(total); tc.setAttribute('value', money(total)); }
      else { var p2 = baseRow.querySelector('.cart-items__price'); if (p2) p2.textContent = money(total); }

      // Detail list (case + charms + total) under the details cell.
      var details = baseRow.querySelector('.cart-items__details') || baseRow;
      var ul = document.createElement('ul');
      ul.className = 'charme-bundle-detail';
      var li0 = document.createElement('li');
      li0.innerHTML = '<span>Case</span><span>' + money(base.final_line_price) + '</span>';
      ul.appendChild(li0);
      charms.forEach(function (it) {
        var li = document.createElement('li');
        li.innerHTML = '<span>' + (it.product_title || it.title) + (it.quantity > 1 ? ' \u00d7' + it.quantity : '') + '</span><span>' + money(it.final_line_price) + '</span>';
        ul.appendChild(li);
      });
      var lt = document.createElement('li');
      lt.className = 'charme-bundle-total';
      lt.innerHTML = '<span>Custom case total</span><span>' + money(total) + '</span>';
      ul.appendChild(lt);
      details.appendChild(ul);

      // "Edit design" — reopen the customizer with this design loaded so the
      // customer can keep tweaking (see entry.jsx ?charme_edit handling).
      var editUrl = '/products/custom-charm-phone-case?charme_edit=' + encodeURIComponent(base.key);
      var edit = document.createElement('a');
      edit.className = 'charme-edit-btn';
      edit.href = editUrl;
      edit.textContent = 'Edit design';
      details.appendChild(edit);

      baseRow.setAttribute('data-charme-grouped', '1');
    });
  }

  // If a base case line is removed, its charm lines are orphaned — remove them
  // too so the cart stays consistent (charm rows are hidden and can't be removed
  // on their own). Detects any _design_token group that has charms but no base.
  async function cleanupOrphans() {
    if (window.__charmeCleaning) return;
    var cart;
    try { cart = await fetch('/cart.js', { headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); }); }
    catch (e) { return; }
    if (!cart || !cart.items) return;
    var byTok = {};
    cart.items.forEach(function (it) {
      var t = it.properties && it.properties._design_token;
      if (!t) return;
      (byTok[t] = byTok[t] || []).push(it);
    });
    var updates = {};
    Object.keys(byTok).forEach(function (t) {
      var g = byTok[t];
      var hasBase = g.some(function (it) { return !(it.properties && it.properties._role === 'charm'); });
      if (!hasBase) g.forEach(function (it) { updates[it.key] = 0; });
    });
    if (Object.keys(updates).length) {
      window.__charmeCleaning = true;
      try {
        await fetch('/cart/update.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ updates: updates }) });
      } catch (e) {}
      window.location.reload();
    }
  }

  function applyAll() {
    cleanupOrphans();
    var comps = document.querySelectorAll('cart-items-component');
    if (comps.length) comps.forEach(applyIn);
    else applyIn(document);
  }

  function boot() {
    applyAll();
    // Re-apply whenever the theme re-renders the cart (add / qty change / remove).
    var t;
    var reapply = function () { clearTimeout(t); t = setTimeout(applyAll, 150); };
    var comps = document.querySelectorAll('cart-items-component');
    (comps.length ? comps : [document.body]).forEach(function (c) {
      new MutationObserver(reapply).observe(c, { childList: true, subtree: true });
    });
    document.addEventListener('cart:refresh', applyAll);
    document.addEventListener('cart:updated', applyAll);
  }
  if (document.readyState !== 'loading') boot();
  else document.addEventListener('DOMContentLoaded', boot);
})();
</script>
