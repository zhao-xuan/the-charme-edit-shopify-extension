{% comment %}
  Charmé cart styling + orphan cleanup — Horizon-style themes.
  ---------------------------------------------------------------------------
  A custom design is added as several cart lines (base case + one line per charm)
  sharing a `_design_token` property; charm lines carry `_role: 'charm'`. The
  visual folding into a single "Custom Charm Case" row is done SERVER-SIDE in
  snippets/charme-cart-line.liquid (rendered from cart-products.liquid), so it
  works in the cart page AND the drawer with no JS/timing issues.

  This snippet only provides:
    1. The shared CSS for the folded row (breakdown list, edit button, contained
       proof preview image).
    2. Orphan cleanup — if the base case line is removed, its (never-shown) charm
       lines are deleted so they don't linger through to checkout.

  ⚠️ Cosmetic, cart-only — the CHECKOUT page still shows the separate lines
  (that needs Checkout Extensibility + a Cart Transform function).

  INSTALL: paste `{% render 'charme-cart-group' %}` once near the end of
  layout/theme.liquid (just before </body>).
{% endcomment %}

<style>
  .charme-bundle-detail{list-style:none;margin:8px 0 0;padding:8px 10px;background:rgb(var(--color-foreground-rgb)/0.05);border-radius:8px;font-size:.85em;line-height:1.6}
  .charme-bundle-detail li{display:flex;justify-content:space-between;gap:10px}
  .charme-bundle-detail li.charme-bundle-total{font-weight:600;border-top:1px solid rgb(var(--color-foreground-rgb)/0.15);margin-top:4px;padding-top:4px}
  .charme-row-hidden{display:none !important}
  .charme-edit-btn{display:inline-block;margin-top:8px;padding:5px 12px;border:1px solid currentColor;border-radius:6px;font-size:.82em;text-decoration:none;color:inherit;cursor:pointer}
  .charme-edit-btn:hover{opacity:.7}
  /* Keep the design preview (a tall phone-case shot) within the thumbnail cell */
  .cart-items__media-container.charme-proof-container{aspect-ratio:auto !important}
  .charme-proof-img{width:100% !important;height:auto !important;max-height:120px !important;object-fit:contain !important;aspect-ratio:auto !important}
  .charme-floating-cart{position:fixed;right:10px;top:50%;margin-top:-24px;width:48px;height:48px;border:0;border-radius:24px;background:#3d3530;color:#f7f0df;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:3000;box-shadow:0 0 5px grey}
  .charme-floating-cart:hover{opacity:.94}
  .charme-floating-cart__badge{position:absolute;top:-6px;right:-6px;min-width:22px;height:22px;padding:0 5px;border-radius:20px;background:#9f1010;color:#fff;font-size:12px;font-weight:700;line-height:22px;text-align:center;display:none}
  .charme-floating-cart__badge:not([hidden]){display:block}
</style>

<script>
(function () {

  function syncEditorMarket(link) {
    var shopify = window.Shopify || {};
    var market = shopify.currency || {};
    var currency = String(market.active || '').toUpperCase();
    var country = String(shopify.country || '').toUpperCase();
    var rate = Number(market.rate);
    if (!/^[A-Z]{3}$/.test(currency) || !/^[A-Z]{2}$/.test(country)) return;
    ['href', 'data-charme-edit-url'].forEach(function (attribute) {
      var value = link.getAttribute(attribute);
      if (!value) return;
      try {
        var url = new URL(value, window.location.origin);
        if (url.origin !== 'https://charme-customizer.pages.dev' || !/^\/editor\/?$/.test(url.pathname)) return;
        url.searchParams.set('currency', currency);
        url.searchParams.set('country', country);
        if (currency === 'GBP') url.searchParams.set('currency_rate', '1');
        else if (Number.isFinite(rate) && rate > 0) url.searchParams.set('currency_rate', String(rate));
        else url.searchParams.delete('currency_rate');
        if (shopify.locale) url.searchParams.set('locale', shopify.locale);
        if (value !== url.toString()) link.setAttribute(attribute, url.toString());
      } catch (error) {}
    });
  }

  function syncEditorMarkets() {
    document.querySelectorAll('a[href], a[data-charme-edit-url]').forEach(syncEditorMarket);
  }

  function syncPressedEditorMarket(event) {
    var link = event.target && event.target.closest && event.target.closest('a');
    if (link) syncEditorMarket(link);
  }

  ['pointerdown', 'touchstart', 'click', 'auxclick', 'contextmenu'].forEach(function (type) {
    document.addEventListener(type, syncPressedEditorMarket, true);
  });
  window.addEventListener('pageshow', syncEditorMarkets);
  var marketSyncPending = false;
  new MutationObserver(function () {
    if (marketSyncPending) return;
    marketSyncPending = true;
    setTimeout(function () {
      marketSyncPending = false;
      syncEditorMarkets();
    }, 0);
  }).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['href', 'data-charme-edit-url'] });
  syncEditorMarkets();

  var floatingButton;
  var floatingBadge;

  var latestCart = null;
  var refreshTimer;

  function ensureFloatingButton() {
    if (floatingButton && document.body.contains(floatingButton)) return;
    floatingButton = document.querySelector('[data-charme-floating-cart]');
    if (!floatingButton) {
      floatingButton = document.createElement('button');
      floatingButton.type = 'button';
      floatingButton.className = 'charme-floating-cart';
      floatingButton.setAttribute('data-charme-floating-cart', '1');
      floatingButton.setAttribute('aria-label', 'Open cart');
      floatingButton.innerHTML = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22.8092 6.13574C22.7808 5.74023 22.4156 5.43262 21.9731 5.43262H17.5419V4.25977C17.5419 1.91113 15.0555 0 12 0C8.94453 0 6.45807 1.91113 6.45807 4.25977V5.43262H2.02693C1.58436 5.43262 1.21919 5.74023 1.19085 6.13574L0.00157807 23.2031C-0.0125929 23.4102 0.0691626 23.6123 0.227223 23.7637C0.385283 23.9141 0.606568 24 0.837663 24H23.1623C23.3934 24 23.6147 23.9141 23.7728 23.7637C23.9308 23.6123 24.0126 23.4102 23.9984 23.2031L22.8092 6.13574ZM8.13243 4.25977C8.13243 2.73828 9.86782 1.5 12 1.5C14.1322 1.5 15.8676 2.73828 15.8676 4.25977V5.43262H8.13243V4.25977ZM6.45807 6.93262V8.56152C6.45807 8.97559 6.83306 9.31152 7.29525 9.31152C7.75744 9.31152 8.13243 8.97559 8.13243 8.56152V6.93262H15.8676V8.56152C15.8676 8.97559 16.2426 9.31152 16.7048 9.31152C17.1669 9.31152 17.5419 8.97559 17.5419 8.56152V6.93262H21.186L21.9114 17.333H2.08859L2.81396 6.93262H6.45807ZM1.72825 22.5L2.01889 18.333H21.9811L22.2717 22.5H1.72825Z" fill="currentColor"></path></svg><span class="charme-floating-cart__badge" hidden>0</span>';
      document.body.appendChild(floatingButton);
    }
    floatingBadge = floatingButton.querySelector('.charme-floating-cart__badge');
    if (!floatingButton.__charmeBound) {
      floatingButton.__charmeBound = true;
      floatingButton.addEventListener('click', function () {
        var trigger = document.querySelector('[data-testid="cart-drawer-trigger"]');
        if (trigger) {
          trigger.click();
          return;
        }
        window.location.href = '/cart';
      });
    }
  }

  function logicalCount(cart) {
    var count = 0;
    (cart.items || []).forEach(function (item) {
      if (item && item.properties && item.properties._role === 'charm') return;
      count += Number(item.quantity) || 0;
    });
    return count;
  }

  function updateFloatingBadge(cart) {
    ensureFloatingButton();
    if (!floatingBadge) return;
    var count = logicalCount(cart);
    floatingBadge.textContent = String(count);
    if (count > 0) floatingBadge.removeAttribute('hidden');
    else floatingBadge.setAttribute('hidden', 'hidden');
  }

  function base64UrlEncode(value) {
    var bytes = new TextEncoder().encode(value);
    var binary = '';
    for (var i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
    return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }

  function hydrateEditLinks(cart) {
    var layouts = {};
    (cart.items || []).forEach(function (item) {
      var properties = item.properties || {};
      var token = properties._design_token;
      var layout = properties._layout;
      if (!token || properties._role === 'charm' || typeof layout !== 'string' || !layout || layout.length > 120000) return;
      try { JSON.parse(layout); } catch (error) { return; }
      layouts[token] = layout;
    });
    document.querySelectorAll('[data-charme-edit-token][data-charme-edit-url]').forEach(function (link) {
      var token = link.getAttribute('data-charme-edit-token') || '';
      var layout = layouts[token];
      if (!/^[A-Za-z0-9_-]{1,128}$/.test(token) || !layout) return;
      try {
        var url = new URL(link.getAttribute('data-charme-edit-url'), window.location.origin);
        var hash = new URLSearchParams();
        hash.set('charme_layout', base64UrlEncode(layout));
        hash.set('charme_edit_token', token);
        url.hash = hash.toString();
        link.href = url.toString();
        link.setAttribute('data-charme-edit-ready', '1');
      } catch (error) {}
    });
  }

  function decodeBridgePayload(encoded) {
    if (!encoded || encoded.length > 200000 || !/^[A-Za-z0-9_-]+$/.test(encoded) || encoded.length % 4 === 1) throw new Error('Invalid cart payload encoding');
    var base64 = encoded.replace(/-/g, '+').replace(/_/g, '/');
    while (base64.length % 4) base64 += '=';
    var binary = atob(base64);
    var bytes = new Uint8Array(binary.length);
    for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    try { return JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes)); }
    catch (error) { throw new Error('Invalid cart payload JSON'); }
  }

  function bridgeItems(payload) {
    if (!payload || payload.version !== 1 || !Array.isArray(payload.items) || !payload.items.length || payload.items.length > 100) {
      throw new Error('Invalid cart payload');
    }
    if (payload.replaceDesignToken != null && !/^[A-Za-z0-9_-]{1,128}$/.test(payload.replaceDesignToken)) throw new Error('Invalid replacement design token');
    var groups = Object.create(null);
    var items = payload.items.map(function (raw, index) {
      var id = Number(raw && raw.id);
      var quantity = raw && raw.quantity == null ? 1 : Number(raw && raw.quantity);
      if (!raw || !/^[0-9]+$/.test(String(raw.id)) || !Number.isSafeInteger(id) || id <= 0 || !/^[0-9]+$/.test(String(raw.quantity == null ? 1 : raw.quantity)) || !Number.isSafeInteger(quantity) || quantity <= 0) {
        throw new Error('Invalid cart item at index ' + index);
      }
      if (!raw.properties || typeof raw.properties !== 'object' || Array.isArray(raw.properties)) throw new Error('Invalid cart properties at index ' + index);
      var properties = {};
      Object.keys(raw.properties).forEach(function (key) {
        var value = raw.properties[key];
        if (!key || key === '__proto__' || key === 'constructor' || key === 'prototype' || key.length > 255 || value == null || !['string', 'number', 'boolean'].includes(typeof value) || String(value).length > 120000) {
          throw new Error('Invalid cart properties at index ' + index);
        }
        properties[key] = String(value);
      });
      var token = properties._design_token;
      if (!token || !/^[A-Za-z0-9_-]{1,128}$/.test(token) || token === '__proto__' || token === 'constructor' || token === 'prototype') throw new Error('Invalid design token at index ' + index);
      if (properties._role && properties._role !== 'charm') throw new Error('Invalid design role at index ' + index);
      if (!groups[token]) groups[token] = { bases: 0 };
      if (properties._role !== 'charm') groups[token].bases++;
      return { id: id, quantity: quantity, properties: properties };
    });
    Object.keys(groups).forEach(function (token) {
      if (groups[token].bases !== 1) throw new Error('Each design must contain exactly one base item');
    });
    return items;
  }

  function missingBridgeItems(items, cart) {
    function identity(item) {
      var properties = item.properties || {};
      return JSON.stringify([String(item.variant_id || item.id), Object.keys(properties).sort().map(function (key) { return [key, String(properties[key])]; })]);
    }
    var quantities = {};
    (cart.items || []).forEach(function (item) {
      var key = identity(item);
      quantities[key] = (quantities[key] || 0) + Number(item.quantity || 0);
    });
    return items.reduce(function (missing, item) {
      var key = identity(item);
      var available = quantities[key] || 0;
      quantities[key] = Math.max(0, available - item.quantity);
      if (available < item.quantity) missing.push(Object.assign({}, item, { quantity: item.quantity - available }));
      return missing;
    }, []);
  }

  var bridgeStatus;
  function bridgeEncoded() {
    return new URLSearchParams(location.hash.replace(/^#/, '')).get('charme-cart');
  }

  function clearBridgeHash(encoded) {
    if (bridgeEncoded() !== encoded) return;
    var params = new URLSearchParams(location.hash.replace(/^#/, ''));
    params.delete('charme-cart');
    history.replaceState(null, '', location.pathname + location.search + (params.toString() ? '#' + params.toString() : ''));
  }

  function showBridgeStatus(text, retry, recoveryItems) {
    if (!bridgeStatus) {
      bridgeStatus = document.createElement('div');
      bridgeStatus.setAttribute('role', 'status');
      bridgeStatus.setAttribute('aria-live', 'polite');
      bridgeStatus.setAttribute('data-charme-cart-status', '');
      bridgeStatus.style.cssText = 'position:fixed;inset:0;z-index:2147483640;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;padding:24px;overflow:auto;text-align:center;color:#222;font-family:inherit;font-size:18px;line-height:1.5;';
      document.body.appendChild(bridgeStatus);
    }
    bridgeStatus.replaceChildren();
    var label = document.createElement('p');
    label.style.cssText = 'max-width:460px;max-height:40vh;overflow:auto;overflow-wrap:anywhere;margin:0;';
    label.textContent = text;
    bridgeStatus.appendChild(label);
    if (retry) {
      var button = document.createElement('button');
      button.type = 'button';
      button.textContent = 'Retry';
      button.className = 'button';
      button.onclick = function () { window.__charmeBridgeFailed = false; applyCartBridge(); };
      bridgeStatus.appendChild(button);
    }
    if (recoveryItems) {
      var designer = document.createElement('a');
      var destination = new URL('https://charme-customizer.pages.dev/editor');
      var base = recoveryItems.find(function (item) { return item.properties && item.properties._role !== 'charm'; });
      try {
        var layout = base && base.properties._layout;
        if (layout && typeof JSON.parse(layout) === 'object') destination.hash = 'charme_layout=' + base64UrlEncode(layout);
      } catch (error) {}
      designer.href = destination.href;
      designer.textContent = 'Return to designer';
      designer.style.cssText = 'color:#222;text-decoration:underline;min-height:44px;display:inline-flex;align-items:center;';
      bridgeStatus.appendChild(designer);
      var viewCart = document.createElement('a');
      viewCart.href = location.pathname + location.search;
      viewCart.textContent = 'View cart';
      viewCart.style.cssText = designer.style.cssText;
      bridgeStatus.appendChild(viewCart);
    }
  }

  function bridgeDiagnosticText(value) {
    return String(typeof value === 'object' ? JSON.stringify(value) : value || '').replace(/https?:\/\/[^\s"<>]+/g, '[url]').replace(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi, '[email]').slice(0, 1000);
  }

  async function bridgeRequest(resource, options) {
    var controller = new AbortController();
    var timeout = setTimeout(function () { controller.abort(); }, options ? 20000 : 5000);
    var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    var details = { endpoint: root + resource, method: options && options.method || 'GET', status: null, requestId: null, response: null };
    try {
      var response = await fetch(root + resource, Object.assign({ cache: 'no-store' }, options || {}, { signal: controller.signal }));
      details.status = response.status;
      details.requestId = response.headers.get('x-request-id');
      details.contentType = response.headers.get('content-type');
      var text = await response.text();
      var body;
      try { body = JSON.parse(text); }
      catch (error) { throw new Error('Shopify returned an unreadable response. Please retry.'); }
      details.response = {};
      ['status', 'description', 'message', 'errors'].forEach(function (key) {
        if (body && body[key] != null) details.response[key] = bridgeDiagnosticText(body[key]);
      });
      if (!response.ok) throw new Error(body && (body.description || body.message) || 'Shopify could not update your cart.');
      if (!body || typeof body !== 'object' || (resource === 'cart.js' && !Array.isArray(body.items))) throw new Error('Shopify returned an invalid cart response. Please retry.');
      return body;
    } catch (error) {
      if (error.name === 'AbortError') error = new Error('The connection timed out. Retry to check your cart before adding anything again.');
      error.bridgeDetails = details;
      throw error;
    } finally { clearTimeout(timeout); }
  }

  async function applyCartBridge() {
    var encoded = bridgeEncoded();
    if (window.__charmeAdding) return true;
    if (!encoded) {
      if (bridgeStatus) { bridgeStatus.remove(); bridgeStatus = null; }
      window.__charmeBridgeFailed = false;
      return false;
    }
    if (window.__charmeBridgeFailed && window.__charmeBridgePayload === encoded) return true;
    var completed = window.__charmeBridgeCompleted || (window.__charmeBridgeCompleted = []);
    if (completed.includes(encoded)) {
      clearBridgeHash(encoded);
      if (bridgeStatus) { bridgeStatus.remove(); bridgeStatus = null; }
      window.__charmeBridgeFailed = false;
      return true;
    }
    window.__charmeBridgePayload = encoded;
    window.__charmeBridgeFailed = false;
    window.__charmeAdding = true;
    var stage = 'validate';
    var items = [];
    var batch = [];
    showBridgeStatus('Checking your cart...', false);
    var slowTimer = setTimeout(function () { showBridgeStatus('Shopify is taking longer than usual. We are checking your design; please keep this page open.', false); }, 5000);
    try {
      if (new URLSearchParams(location.hash.replace(/^#/, '')).getAll('charme-cart').length !== 1) throw new Error('Ambiguous cart payload');
      var payload = decodeBridgePayload(encoded);
      items = bridgeItems(payload);
      stage = 'read-cart';
      var cart = await bridgeRequest('cart.js');
      var missing = missingBridgeItems(items, cart);
      if (missing.length) {
        showBridgeStatus('Adding your design to your cart...', false);
        for (var offset = 0; offset < missing.length; offset += 20) {
          stage = 'add-items';
          batch = missing.slice(offset, offset + 20);
          await bridgeRequest('cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items: batch }),
          });
        }
      }

      showBridgeStatus('Confirming your cart...', false);
      stage = 'verify-cart';
      var verified = await bridgeRequest('cart.js');
      if (missingBridgeItems(items, verified).length) throw new Error('Your design is not fully in the cart yet. Please retry.');

      var replaceToken = String(payload.replaceDesignToken || '');
      var incomingTokens = {};
      items.forEach(function (item) {
        var token = item.properties && item.properties._design_token;
        if (token) incomingTokens[token] = true;
      });
      if (/^[A-Za-z0-9_-]{1,128}$/.test(replaceToken) && !incomingTokens[replaceToken]) {
        var refreshed = verified;
        var updates = {};
        (refreshed.items || []).forEach(function (item) {
          if (item.properties && item.properties._design_token === replaceToken) updates[item.key] = 0;
        });
        if (Object.keys(updates).length) {
          stage = 'replace-design';
          await bridgeRequest('cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ updates: updates }),
          });
        }
      }

      if (typeof refreshCartUi === 'function') {
        stage = 'refresh-cart';
        await refreshCartUi();
        clearBridgeHash(encoded);
        bridgeStatus.remove();
        bridgeStatus = null;
        window.__charmeAdding = false;
      } else {
        clearBridgeHash(encoded);
        if (!bridgeEncoded()) window.location.reload();
      }
      completed.push(encoded);
      if (completed.length > 8) completed.shift();
    } catch (error) {
      window.__charmeBridgeFailed = bridgeEncoded() === encoded;
      var diagnostic = Object.assign({ event: 'charme_cart_bridge_failed', version: 2, stage: stage, message: bridgeDiagnosticText(error.message), itemCount: items.length, batch: stage === 'add-items' ? batch.map(function (item) { return { variantId: item.id, quantity: item.quantity }; }) : [] }, error.bridgeDetails || {});
      console.error('[Charme] cart bridge failed', JSON.stringify(diagnostic));
      if (window.__charmeBridgeFailed) showBridgeStatus(stage === 'validate' ? 'This design link is invalid. Return to the designer to try again.' : (error.message || 'Could not update your cart.') + ' Your design is saved in this link.', stage !== 'validate', items);
    } finally {
      clearTimeout(slowTimer);
      window.__charmeAdding = false;
      if (bridgeEncoded() && bridgeEncoded() !== encoded) Promise.resolve().then(applyCartBridge);
      else if (!bridgeEncoded() && bridgeStatus) { bridgeStatus.remove(); bridgeStatus = null; }
    }
    return true;
  }

  if (!window.__charmeBridgeEventsBound) {
    window.__charmeBridgeEventsBound = true;
    window.addEventListener('pageshow', function () { applyCartBridge(); });
    window.addEventListener('hashchange', function () { applyCartBridge(); });
  }

  function groupedUpdates(cart, targetKey, quantity) {
    var target = (cart.items || []).find(function (item) { return item.key === targetKey; });
    var targetToken = target && target.properties && target.properties._design_token;
    if (!targetToken) return null;
    var updates = {};
    (cart.items || []).forEach(function (item) {
      if (item.properties && item.properties._design_token === targetToken) updates[item.key] = quantity;
    });
    return updates;
  }

  async function updateDesignGroup(targetKey, quantity) {
    if (window.__charmeGroupUpdating) return false;
    var cart = await fetch('/cart.js', { headers: { Accept: 'application/json' }, cache: 'no-store' }).then(function (response) {
      if (!response.ok) throw new Error('Could not read cart');
      return response.json();
    });
    var updates = groupedUpdates(cart, targetKey, quantity);
    if (!updates) return false;
    window.__charmeGroupUpdating = true;
    try {
      var response = await fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ updates: updates }),
      });
      if (!response.ok) throw new Error('Could not update design');
      window.location.reload();
    } catch (error) {
      window.__charmeGroupUpdating = false;
      throw error;
    }
    return true;
  }

  // If a base case line is removed, its charm lines are orphaned — remove them
  // too so the cart stays consistent (charm rows are hidden and can't be removed
  // on their own). Detects any _design_token group that has charms but no base.
  async function cleanupOrphans(cart) {
    if (window.__charmeCleaning) return;
    if (!cart || !cart.items) return;
    var byTok = {};
    cart.items.forEach(function (it) {
      var t = it.properties && it.properties._design_token;
      if (!t) return;
      (byTok[t] = byTok[t] || []).push(it);
    });
    var updates = {};
    Object.keys(byTok).forEach(function (t) {
      var g = byTok[t];
      var hasBase = g.some(function (it) { return !(it.properties && it.properties._role === 'charm'); });
      if (!hasBase) g.forEach(function (it) { updates[it.key] = 0; });
    });
    if (Object.keys(updates).length) {
      window.__charmeCleaning = true;
      try {
        await fetch('/cart/update.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ updates: updates }) });
      } catch (e) {}
      window.location.reload();
    }
  }

  async function applyAll() {
    if (await applyCartBridge()) return;
    var cart;
    try { cart = await fetch('/cart.js', { headers: { Accept: 'application/json' }, cache: 'no-store' }).then(function (r) {
      if (!r.ok) throw new Error('Could not read cart');
      return r.json();
    }); }
    catch (e) { return; }
    latestCart = cart;
    updateFloatingBadge(cart);
    hydrateEditLinks(cart);
    // Visual folding is now done SERVER-SIDE (snippets/charme-cart-line.liquid),
    // so it works in the cart page AND the drawer with no timing issues. Here we
    // only clean up orphaned charm lines when the base case is removed.
    cleanupOrphans(cart);
  }

  function boot() {
    ensureFloatingButton();
    applyAll();
    var t;
    var reapply = function () {
      clearTimeout(t);
      t = setTimeout(function () {
        if (latestCart) hydrateEditLinks(latestCart);
      }, 120);
    };
    var refresh = function () {
      clearTimeout(refreshTimer);
      refreshTimer = setTimeout(applyAll, 250);
    };

    // Re-check for orphaned charm lines whenever the cart re-renders in the cart
    // page or the drawer (the drawer is re-rendered wholesale on add-to-cart — a
    // childList change under <body>). Debounced; cleanup is a no-op unless a base
    // case was removed.
    new MutationObserver(reapply).observe(document.body, { childList: true, subtree: true });

    // The cart drawer is a <dialog> inside <cart-drawer-component>; also re-check
    // when the user opens it.
    document.addEventListener('click', function (e) {
      var t2 = e.target;
      var groupedRemove = t2 && t2.closest && t2.closest('[data-charme-remove-group]');
      if (groupedRemove) {
        e.preventDefault();
        e.stopImmediatePropagation();
        updateDesignGroup(groupedRemove.getAttribute('data-charme-key'), 0).catch(function (error) {
          console.error('[Charmé] grouped cart removal failed', error);
          window.alert('We could not remove this design. Please refresh the page to try again.');
        });
        return;
      }
      if (t2 && t2.closest && t2.closest('[data-testid="cart-drawer-trigger"], cart-drawer-component, .cart-drawer, a[href$="/cart"]')) reapply();
      if (t2 && t2.closest && t2.closest('.cart-items__remove')) refresh();
    }, true);

    ['cart:refresh', 'cart:updated', 'cart:change', 'cart:add', 'on:cart:update'].forEach(function (ev) {
      document.addEventListener(ev, refresh);
    });

    // A couple of delayed passes for late-hydrating drawers.
    [400, 1200].forEach(function (d) {
      setTimeout(function () {
        if (latestCart) hydrateEditLinks(latestCart);
        else applyAll();
      }, d);
    });
  }
  if (document.readyState !== 'loading') boot();
  else document.addEventListener('DOMContentLoaded', boot);
})();
</script>
